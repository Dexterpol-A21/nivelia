---
import EkiliaButtons from '@components/ui/EkiliaButtons.astro';
import Grainient from '@components/ui/Grainient.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { PAGES, SYSTEM } from '@utils/constants';
---

<BaseLayout title={PAGES.sistema.title} description={PAGES.sistema.description} chrome={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <article class="sistema">
    <header class="sistema__intro grain-host">
      <Grainient tone="cream" />
      <p class="sistema__word">Ekilia</p>
      <div>
        <h1>Sistema gráfico.</h1>
        <p>
          Nutrición para tu bienestar, reposición cada mes. Hueso, azul, turquesa y mora. Tipo
          editorial, botones cuadrados. Esto es lo que se usa; lo demás no entra. Los archivos para
          bajar están en
          <a href="/marca">Marca</a>.
        </p>
      </div>
    </header>

    <section class="sistema__rules grain-host" aria-label="Reglas">
      <Grainient tone="forest" />
      <ul>
        {SYSTEM.rules.map((rule) => <li>{rule}</li>)}
      </ul>
    </section>

    <section class="sistema__color grain-host" aria-label="Color">
      <Grainient tone="cream" />
      <h2>Color</h2>
      <p>Cuatro valores de marca. Nada más entra como campo.</p>
      <ul>
        {
          SYSTEM.colors.map((color) => (
            <li class={`is-on-${color.on} grain-host`} style={`background: ${color.hex}`}>
              <Grainient
                tone={
                  color.hex === '#0E6E9E'
                    ? 'forest'
                    : color.hex === '#0F6468'
                      ? 'turquoise'
                      : color.hex === '#3E2770'
                        ? 'petroleum'
                        : 'cream'
                }
              />
              <p>{color.name}</p>
              <p>{color.hex}</p>
              <p>{color.role}. {color.use}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sistema__type grain-host" aria-label="Tipografía">
      <Grainient tone="forest" />
      <div class="sistema__type-meta">
        <h2>Tipo</h2>
        <p>
          {SYSTEM.type.display} para lo que se nombra. {SYSTEM.type.body} para lo que se opera.{' '}
          {SYSTEM.type.weights}
        </p>
      </div>
      <div class="sistema__specimens">
        <p class="is-word">Ekilia</p>
        <p class="is-h1">Nutrición para tu bienestar.</p>
        <p class="is-claim">Equilibra tu mente. Recupera tu bienestar.</p>
        <p class="is-body">Dos cápsulas al día, con los alimentos. Ciencia clara, origen botánico.</p>
        <p class="is-cta">Empezar reposición</p>
      </div>
    </section>

    <section class="sistema__buttons grain-host" aria-label="Botones">
      <Grainient tone="petroleum" />
      <div>
        <h2>Botones</h2>
        <p>
          Siempre cuadrados, 2.75 rem de alto. Bloom abre con el color de la placa: turquesa solo sobre turquesa. Tinta sube la palabra y
          endereza la flecha. Sobre color, trazo hueso. Sobre hueso, trazo tinta.
        </p>
      </div>
      <EkiliaButtons primary="Empezar reposición" primaryHref="/reposicion" secondary="Ver Centia" secondaryHref="/centia" />
    </section>

    <section class="sistema__buttons is-hueso grain-host" aria-label="Botones sobre hueso">
      <Grainient tone="cream" />
      <div>
        <h2>Sobre hueso.</h2>
        <p>
          El trazo hueso desaparece. Entrar y Crear cuenta van en tinta #1A1228. Al hover el relleno toma el color de las letras, tinta, y la palabra queda hueso #E6DFD4, el color del fondo. La tinta
          subraya y endereza la flecha.
        </p>
      </div>
      <EkiliaButtons primary="Entrar" primaryHref="/cuenta" secondary="Crear cuenta" secondaryHref="/cuenta" />
    </section>

    <section class="sistema__layout grain-host" aria-label="Layout">
      <Grainient tone="cream" />
      <h2>Layout</h2>
      <div class="sistema__plates" data-slide-host aria-hidden="true">
        <div class="is-cream grain-host" data-slide="left">
          <Grainient tone="cream" />
          Hueso
        </div>
        <div class="is-forest grain-host" data-slide="right">
          <Grainient tone="forest" />
          Azul
        </div>
      </div>
      <div class="sistema__bar-host" data-slide-host aria-hidden="true">
        <div class="is-petroleum grain-host" data-slide="left">
          <Grainient tone="petroleum" />
          Mora
        </div>
      </div>
      <ul>
        <li>Hero y productos: placas a sangre, 50 / 50 desde 900 px.</li>
        <li>Las placas entran desde los lados, una vez. Host recorta; el color va en el pane. Cada placa apilada es su propio host. Hero no entra.</li>
        <li>Menú: se abre al clic, no al hover. Riel estrecho (reposición) a la izquierda; índice a la derecha, fórmulas en Fraunces y páginas en Outfit. No copia el hero.</li>
        <li>Alineación a la izquierda. Cajas sin sombra y sin radio.</li>
        <li>Barra de scroll: riel hueso, pulgar azul, hover turquesa.</li>
      </ul>
    </section>

    <section class="sistema__avoid grain-host" aria-label="Fuera de marca">
      <Grainient tone="ink" />
      <h2>No entra</h2>
      <ul>
        {SYSTEM.avoid.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .sistema {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --cream-deep: #e6dfd4;
    --forest: #0e6e9e;
    --petroleum: #3e2770;
    --turquoise: #0f6468;
    --ink: #1A1228;
  }

  .sistema h2 {
    font-family: Fraunces, serif;
    margin: 0 0 0.8rem;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .sistema__intro,
  .sistema__rules,
  .sistema__color,
  .sistema__type,
  .sistema__buttons,
  .sistema__layout,
  .sistema__avoid {
    padding: 4.5rem 1.5rem 3.2rem;
  }

  .sistema__intro {
    min-height: 70dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2rem;
    background: var(--cream);
    color: var(--ink);
  }

  .sistema__word {
    font-family: Fraunces, serif;
    font-optical-sizing: none;
    font-variation-settings: "opsz" 144, "wght" 600;
    margin: 0;
    font-size: clamp(3.2rem, 11vw, 6.4rem);
    font-weight: 600;
    line-height: 0.78;
    letter-spacing: -0.05em;
  }

  .sistema__intro h1 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.15rem, 6vw, 3.8rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .sistema__intro a {
    color: inherit;
    font-weight: 600;
  }

  .sistema__intro p:last-child,
  .sistema__color > p,
  .sistema__type-meta p,
  .sistema__buttons p {
    margin: 0.9rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .sistema__rules {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .sistema__rules ul,
  .sistema__layout ul,
  .sistema__avoid ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sistema__rules li,
  .sistema__layout li,
  .sistema__avoid li {
    font-family: Fraunces, serif;
    max-width: 28rem;
    padding: 0.85rem 0;
    border-top: 1.5px solid color-mix(in srgb, currentColor 28%, transparent);
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .sistema__color {
    background: var(--cream);
    color: var(--ink);
  }

  .sistema__color ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sistema__color li {
    min-height: 14rem;
    padding: 1.4rem 1.3rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .sistema__color li p {
    margin: 0;
  }

  .sistema__color li p:first-child {
    font-family: Fraunces, serif;
    font-size: 1.7rem;
    font-weight: 500;
  }

  .sistema__color li p:nth-child(2) {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .sistema__color li p:last-child {
    margin-top: 0.7rem;
    max-width: 22ch;
    font-size: 0.92rem;
    line-height: 1.4;
    opacity: 0.78;
  }

  .sistema__color li.is-on-cream {
    color: var(--on-dark, var(--cream));
  }

  .sistema__color li.is-on-navy {
    color: #062a3d;
  }

  .sistema__color li.is-on-ink {
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--color-border, #d3e2e8);
  }

  .sistema__type {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .sistema__specimens {
    margin-top: 2.2rem;
  }

  .sistema__specimens p {
    margin: 0;
  }

  .is-word {
    font-family: Fraunces, serif;
    font-size: clamp(3.6rem, 12vw, 7rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.05em;
  }

  .is-h1 {
    font-family: Fraunces, serif;
    margin-top: 1.4rem;
    font-size: clamp(2.15rem, 5vw, 4.2rem);
    font-weight: 500;
    line-height: 1.02;
  }

  .is-claim {
    font-family: Fraunces, serif;
    margin-top: 1.1rem;
    max-width: 18ch;
    font-size: clamp(1.25rem, 3vw, 1.85rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .is-body {
    margin-top: 1.1rem;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.55;
    opacity: 0.88;
  }

  .is-cta {
    margin-top: 1.4rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .sistema__buttons {
    --bloom: var(--petroleum);
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .sistema__buttons :global(.ekilia-btns) {
    margin-top: 1.6rem;
  }

  .sistema__buttons.is-hueso {
    --bloom: var(--ink);
    --bloom-fill: var(--ink);
    --bloom-ink: var(--cream-deep);
    background: var(--cream);
    color: var(--ink);
  }

  .sistema__buttons.is-hueso :global(.ekilia-btns__btn.is-bloom) {
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .sistema__buttons.is-hueso :global(.ekilia-btns__btn.is-tinta) {
    color: var(--ink);
  }

  .sistema__buttons.is-hueso :global(.ekilia-btns__btn:focus-visible) {
    outline-color: var(--ink);
  }

  .sistema__layout {
    background: var(--cream);
    color: var(--ink);
  }

  .sistema__plates {
    display: grid;
    min-height: 12rem;
    margin: 1.6rem 0 0;
  }

  .sistema__plates div {
    font-family: Fraunces, serif;
    display: grid;
    place-items: center;
    min-height: 5.5rem;
    font-size: 1.4rem;
    font-weight: 500;
  }

  .sistema__plates .is-cream {
    background: var(--cream);
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--forest);
  }

  .sistema__plates .is-forest {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .sistema__bar-host {
    margin: 0 0 1.8rem;
  }

  .sistema__bar-host .is-petroleum {
    font-family: Fraunces, serif;
    display: grid;
    place-items: center;
    min-height: 5.5rem;
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
    font-size: 1.4rem;
    font-weight: 500;
  }

  .sistema__avoid {
    background: var(--ink);
    color: var(--on-dark, var(--cream));
  }

  @media (min-width: 900px) {
    .sistema__intro,
    .sistema__rules,
    .sistema__color,
    .sistema__type,
    .sistema__buttons,
    .sistema__layout,
    .sistema__avoid {
      padding: 5rem 2.6rem 3.6rem;
    }

    .sistema__color ul {
      grid-template-columns: 1fr 1fr;
    }

    .sistema__intro {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }

    .sistema__color li {
      min-height: 18rem;
    }

    .sistema__type {
      display: grid;
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      gap: 2rem 3rem;
    }

    .sistema__specimens {
      margin-top: 0;
    }

    .sistema__buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 2rem;
    }

    .sistema__plates {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
