---
import BaseLayout from '@layouts/BaseLayout.astro';
import { PAGES } from '@utils/constants';
import { PALETTES } from '@utils/palettes';

const palettes = PALETTES;

const requested = Astro.url.searchParams.get('paleta');
const palette = palettes.find((item) => item.id === requested) ?? palettes[0];

const fieldOf = {
  crema: { name: palette.creamName, hex: palette.cream },
  bosque: { name: palette.forestName, hex: palette.forest },
  petroleo: { name: palette.petroleumName, hex: palette.petroleum },
} as const;

const plates = [
  {
    tone: 'crema',
    hero: true,
    name: 'Crema',
    note: 'El uso de todos los días.',
    src: '/marca/glyv-tinta.png',
    width: 2400,
    height: 1513,
    alt: 'Wordmark Glyv en tinta',
    files: [
      { href: '/marca/glyv-sobre-crema.png', label: 'PNG con fondo' },
      { href: '/marca/glyv-sobre-crema.svg', label: 'SVG con fondo' },
      { href: '/marca/glyv-tinta.png', label: 'PNG sin fondo' },
      { href: '/marca/glyv-tinta.svg', label: 'SVG sin fondo' },
    ],
  },
  {
    tone: 'bosque',
    name: 'Bosque',
    note: 'Centia y el menú.',
    src: '/marca/glyv-crema.png',
    width: 2400,
    height: 1513,
    alt: 'Wordmark Glyv en crema',
    files: [
      { href: '/marca/glyv-sobre-bosque.png', label: 'PNG con fondo' },
      { href: '/marca/glyv-sobre-bosque.svg', label: 'SVG con fondo' },
      { href: '/marca/glyv-crema.png', label: 'PNG sin fondo' },
      { href: '/marca/glyv-crema.svg', label: 'SVG sin fondo' },
    ],
  },
  {
    tone: 'petroleo',
    name: 'Petróleo',
    note: 'Nervia y la reposición.',
    src: '/marca/glyv-crema.png',
    width: 2400,
    height: 1513,
    alt: 'Wordmark Glyv en crema',
    files: [
      { href: '/marca/glyv-sobre-petroleo.png', label: 'PNG con fondo' },
      { href: '/marca/glyv-sobre-petroleo.svg', label: 'SVG con fondo' },
      { href: '/marca/glyv-crema.png', label: 'PNG sin fondo' },
      { href: '/marca/glyv-crema.svg', label: 'SVG sin fondo' },
    ],
  },
];

const clears = [
  {
    name: 'Tinta',
    note: 'Sobre crema o foto clara.',
    files: [
      { href: '/marca/glyv-tinta.png', label: 'PNG' },
      { href: '/marca/glyv-tinta.svg', label: 'SVG' },
    ],
  },
  {
    name: 'Crema',
    note: 'Sobre bosque, petróleo o foto oscura.',
    files: [
      { href: '/marca/glyv-crema.png', label: 'PNG' },
      { href: '/marca/glyv-crema.svg', label: 'SVG' },
    ],
  },
  {
    name: 'Bosque',
    note: 'Solo si el fondo ya es claro y no es crema.',
    files: [
      { href: '/marca/glyv-bosque.png', label: 'PNG' },
      { href: '/marca/glyv-bosque.svg', label: 'SVG' },
    ],
  },
  {
    name: 'Petróleo',
    note: 'Solo si el fondo ya es claro y no es crema.',
    files: [
      { href: '/marca/glyv-petroleo.png', label: 'PNG' },
      { href: '/marca/glyv-petroleo.svg', label: 'SVG' },
    ],
  },
];

const squares = [
  {
    tone: 'crema',
    name: 'Crema',
    src: '/marca/glyv-cuadrado-crema.png',
    png: '/marca/glyv-cuadrado-crema.png',
    svg: '/marca/glyv-cuadrado-crema.svg',
  },
  {
    tone: 'bosque',
    name: 'Bosque',
    src: '/marca/glyv-cuadrado-bosque.png',
    png: '/marca/glyv-cuadrado-bosque.png',
    svg: '/marca/glyv-cuadrado-bosque.svg',
  },
  {
    tone: 'petroleo',
    name: 'Petróleo',
    src: '/marca/glyv-cuadrado-petroleo.png',
    png: '/marca/glyv-cuadrado-petroleo.png',
    svg: '/marca/glyv-cuadrado-petroleo.svg',
  },
];

const products = [
  {
    tone: 'centia',
    name: 'Centia',
    src: '/marca/centia-crema.png',
    width: 2000,
    height: 709,
    alt: 'Centia en crema',
    files: [
      { href: '/marca/centia-sobre-bosque.png', label: 'PNG sobre bosque' },
      { href: '/marca/centia-sobre-bosque.svg', label: 'SVG sobre bosque' },
      { href: '/marca/centia-sobre-crema.png', label: 'PNG sobre crema' },
      { href: '/marca/centia-crema.png', label: 'PNG sin fondo' },
      { href: '/marca/centia-crema.svg', label: 'SVG sin fondo' },
    ],
    shots: [
      {
        src: '/centia.jpg',
        alt: 'Frasco Glyv Centia con nopal, canela y cápsulas',
        caption: 'Frasco',
        wide: true,
      },
      {
        src: '/centia-botanica.png',
        alt: 'Nopal y canela sobre lino crema',
        caption: 'Origen botánico',
      },
      {
        src: '/centia-ingredientes.png',
        alt: 'Frasco Centia junto a cápsulas, nopal y canela',
        caption: 'La fórmula',
      },
      {
        src: '/centia-toma.png',
        alt: 'Dos cápsulas en el plato, con pan y hojas',
        caption: 'Con los alimentos',
      },
      {
        src: '/centia-manana.png',
        alt: 'Frasco Centia en la cocina, por la mañana',
        caption: 'Cada mañana',
      },
    ],
  },
  {
    tone: 'nervia',
    name: 'Nervia',
    src: '/marca/nervia-crema.png',
    width: 2000,
    height: 678,
    alt: 'Nervia en crema',
    files: [
      { href: '/marca/nervia-sobre-petroleo.png', label: 'PNG sobre petróleo' },
      { href: '/marca/nervia-sobre-petroleo.svg', label: 'SVG sobre petróleo' },
      { href: '/marca/nervia-sobre-crema.png', label: 'PNG sobre crema' },
      { href: '/marca/nervia-crema.png', label: 'PNG sin fondo' },
      { href: '/marca/nervia-crema.svg', label: 'SVG sin fondo' },
    ],
    shots: [
      {
        src: '/nervia.jpg',
        alt: 'Frasco Glyv Nervia con pasiflora y cápsulas',
        caption: 'Frasco',
        wide: true,
      },
      {
        src: '/nervia-botanica.png',
        alt: 'Pasiflora sobre lino crema',
        caption: 'Origen botánico',
      },
      {
        src: '/nervia-ingredientes.png',
        alt: 'Frasco Nervia junto a cápsulas y pasiflora',
        caption: 'La fórmula',
      },
      {
        src: '/nervia-toma.png',
        alt: 'Dos cápsulas junto a una taza de té',
        caption: 'Con los alimentos',
      },
      {
        src: '/nervia-noche.png',
        alt: 'Frasco Nervia en la mesa de noche',
        caption: 'Al cerrar el día',
      },
    ],
  },
];

const shared = [
  {
    src: '/ritual-toma.png',
    alt: 'Dos cápsulas en un plato, junto al pan y las hojas',
    caption: 'La toma',
  },
  {
    src: '/cierre-frasco.png',
    alt: 'Un frasco en el umbral, listo para el mes siguiente',
    caption: 'El frasco que vuelve',
  },
];

const rules = [
  `Sobre ${palette.creamName.toLowerCase()}, el logotipo va en tinta. Sobre ${palette.forestName.toLowerCase()} o ${palette.petroleumName.toLowerCase()}, en ${palette.creamName.toLowerCase()}.`,
  'No lo estires. No le cambies el color ni la letra.',
  'Sin sombra, sin contorno y sin esquinas redondas.',
  'Deja aire alrededor del logotipo. No lo pegues al borde de la pieza.',
  'Las fotos se usan enteras.',
];
---

<BaseLayout title={`${PAGES.marca.title}, ${palette.name}`} description={PAGES.marca.description}>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <article
    class="marca"
    data-palette={palette.id}
    style={`--cream: ${palette.cream}; --forest: ${palette.forest}; --petroleum: ${palette.petroleum}; --ink: ${palette.ink};`}
  >
    <script is:inline define:vars={{ palettes }}>
      const chosen = new URLSearchParams(location.search).get('paleta');
      const active = palettes.find((item) => item.id === chosen) || palettes[0];
      const root = document.currentScript.parentElement;
      root.style.setProperty('--cream', active.cream);
      root.style.setProperty('--forest', active.forest);
      root.style.setProperty('--petroleum', active.petroleum);
      root.style.setProperty('--ink', active.ink);
      if (active.onDark) root.style.setProperty('--on-dark', active.onDark);
      else root.style.removeProperty('--on-dark');
      root.dataset.palette = active.id;
    </script>
    <header class="marca__intro">
      <div>
        <h1>Marca.</h1>
        <p>
          Logotipos, nombres y fotos. Baja el archivo con el fondo que vas a usar, o sin fondo para
          ponerlo encima de una foto. El color y el tipo están en el
          <a href="/sistema">sistema gráfico</a>.
        </p>
        <nav class="marca__switch" aria-label="Paletas">
          {
            palettes.map((item) => (
              <a
                href={`/marca?paleta=${item.id}`}
                aria-current={item.id === palette.id ? 'true' : undefined}
              >
                <span class="marca__chips" aria-hidden="true">
                  <i style={`background: ${item.cream}`} />
                  <i style={`background: ${item.forest}`} />
                  <i style={`background: ${item.petroleum}`} />
                </span>
                {item.name}
              </a>
            ))
          }
        </nav>
        <p data-palette-line>{palette.line} Los archivos para bajar son Campos.</p>
      </div>
    </header>

    <section class="marca__plates" aria-label="Logotipo">
      {
        plates.map((plate) => (
          <div class:list={['marca__plate', `is-${plate.tone}`, plate.hero && 'is-hero']}>
            <p class="marca__mark">Glyv</p>
            <div>
              <h2 data-field={plate.tone}>{fieldOf[plate.tone].name}</h2>
              <p><span data-hex={plate.tone}>{fieldOf[plate.tone].hex}</span>. {plate.note}</p>
              <p class="marca__files">
                {plate.files.map((file) => (
                  <a href={file.href} download>
                    {file.label}
                  </a>
                ))}
              </p>
            </div>
          </div>
        ))
      }
    </section>

    <section class="marca__clear" aria-label="Sin fondo">
      <div class="marca__clear-copy">
        <h2>Sin fondo</h2>
        <p>Para ponerlo sobre una foto. El PNG conserva la transparencia.</p>
        <p class="marca__files">
          <a href="/marca/glyv-sobre-tinta.png" download>PNG sobre tinta</a>
          <a href="/marca/glyv-sobre-tinta.svg" download>SVG sobre tinta</a>
        </p>
      </div>
      <ul>
        {
          clears.map((item) => (
            <li>
              <p>{item.name}</p>
              <p>{item.note}</p>
              <p class="marca__files">
                {item.files.map((file) => (
                  <a href={file.href} download>
                    {file.label}
                  </a>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="marca__squares" aria-label="Cuadrado">
      <div class="marca__squares-copy">
        <h2>Cuadrado</h2>
        <p>Perfil, publicación y miniatura. 1600 px.</p>
      </div>
      <ul>
        {
          squares.map((item) => (
            <li class={`is-${item.tone}`}>
              <p class="marca__square-mark">Glyv</p>
              <p class="marca__files">
                <a href={item.png} download>
                  PNG {item.name.toLowerCase()}
                </a>
                <a href={item.svg} download>
                  SVG {item.name.toLowerCase()}
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="marca__products" aria-label="Nombres y fotos">
      {
        products.map((product) => (
          <div class={`marca__product is-${product.tone}`}>
            <header>
              <p class="marca__name">{product.name}</p>
              <p class="marca__files">
                {product.files.map((file) => (
                  <a href={file.href} download>
                    {file.label}
                  </a>
                ))}
              </p>
            </header>
            <div class="marca__shots">
              {product.shots.map((shot) => (
                <figure class:list={[shot.wide && 'is-wide']}>
                  <img src={shot.src} alt={shot.alt} />
                  <figcaption>
                    <span>{shot.caption}</span>
                    <a href={shot.src} download>
                      Descargar
                    </a>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="marca__shared" aria-label="Fotos de las dos fórmulas">
      <h2>Las dos fórmulas</h2>
      <div class="marca__shots">
        {
          shared.map((shot) => (
            <figure>
              <img src={shot.src} alt={shot.alt} />
              <figcaption>
                <span>{shot.caption}</span>
                <a href={shot.src} download>
                  Descargar
                </a>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="marca__rules" aria-label="Uso">
      <h2>Al usarlo</h2>
      <ul>
        {rules.map((rule, index) => <li data-palette-rule={index === 0 ? 'uso' : undefined}>{rule}</li>)}
      </ul>
    </section>
    <script is:inline define:vars={{ palettes }}>
      const chosen = new URLSearchParams(location.search).get('paleta');
      const active = palettes.find((item) => item.id === chosen) || palettes[0];
      const fields = {
        crema: [active.creamName, active.cream],
        bosque: [active.forestName, active.forest],
        petroleo: [active.petroleumName, active.petroleum],
      };
      document.querySelectorAll('[data-field]').forEach((node) => {
        const pair = fields[node.getAttribute('data-field')];
        if (pair) node.textContent = pair[0];
      });
      document.querySelectorAll('[data-hex]').forEach((node) => {
        const pair = fields[node.getAttribute('data-hex')];
        if (pair) node.textContent = pair[1];
      });
      const line = document.querySelector('[data-palette-line]');
      if (line) line.textContent = `${active.line} Los archivos para bajar son Campos.`;
      const rule = document.querySelector('[data-palette-rule]');
      if (rule) {
        rule.textContent = `Sobre ${active.creamName.toLowerCase()}, el logotipo va en tinta. Sobre ${active.forestName.toLowerCase()} o ${active.petroleumName.toLowerCase()}, en ${active.creamName.toLowerCase()}.`;
      }
      document.title = `Marca, ${active.name} | Glyv`;
      document.querySelectorAll('.marca__switch a').forEach((link) => {
        const on = link.href.includes(`paleta=${active.id}`);
        if (on) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    </script>
  </article>
</BaseLayout>

<style>
  .marca {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --petroleum: #0b4f6c;
    --ink: #1a2a22;
    font-family: Outfit, sans-serif;
    color: var(--ink);
  }

  .marca h2 {
    margin: 0;
    font-family: Fraunces, serif;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .marca a {
    color: inherit;
    font-weight: 600;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.18em;
  }

  .marca a:hover {
    text-decoration-thickness: 2.5px;
  }

  .marca a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .marca__files {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.15rem;
    margin: 0.9rem 0 0;
  }

  .marca__intro {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
    padding: 5.5rem 1.5rem 3.2rem;
  }

  .marca__intro h1 {
    margin: 0;
    max-width: 12ch;
    font-family: Fraunces, serif;
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .marca__intro p {
    margin: 1rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .marca__switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 1.5rem;
  }

  .marca__switch a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    padding: 0 0.95rem;
    border: 1.5px solid color-mix(in srgb, var(--cream) 50%, transparent);
    text-decoration: none;
  }

  .marca__switch a[aria-current='true'] {
    background: var(--cream);
    color: var(--forest);
    border-color: var(--on-dark, var(--cream));
  }

  .marca__chips {
    display: flex;
    width: 2.55rem;
    height: 0.85rem;
  }

  .marca__chips i {
    flex: 1;
    display: block;
  }

  .marca__switch a[aria-current='true'] .marca__chips i:first-child {
    box-shadow: inset 0 0 0 1px var(--forest);
  }

  .marca__mark,
  .marca__square-mark,
  .marca__name {
    margin: 0;
    font-family: Fraunces, serif;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.8;
  }

  .marca__mark {
    font-size: clamp(4.2rem, 12vw, 7rem);
  }

  .marca__plate.is-hero .marca__mark {
    font-size: clamp(5rem, 16vw, 9rem);
  }

  .marca__square-mark {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--cream);
    color: var(--ink);
    font-size: clamp(3rem, 7vw, 4.6rem);
  }

  .marca__squares li.is-bosque .marca__square-mark {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .marca__squares li.is-petroleo .marca__square-mark {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .marca__squares li.is-crema .marca__square-mark {
    box-shadow: inset 0 0 0 1.5px var(--forest);
  }

  .marca__name {
    font-weight: 500;
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: -0.04em;
    color: var(--on-dark, var(--cream));
  }

  .marca__plate {
    padding: 2.4rem 1.5rem 2.2rem;
  }

  .marca__plate.is-hero {
    padding-top: 3.2rem;
    padding-bottom: 2.8rem;
  }

  .marca__plate img {
    display: block;
    width: min(100%, 28rem);
    height: auto;
  }

  .marca__plate.is-hero img {
    width: min(100%, 52rem);
  }

  .marca__plate h2 {
    margin-top: 1.6rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .marca__plate p,
  .marca__clear-copy p,
  .marca__squares-copy p {
    margin: 0.55rem 0 0;
    max-width: 28rem;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .marca__plate.is-crema {
    background: var(--cream);
    color: var(--ink);
  }

  .marca__plate.is-bosque {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .marca__plate.is-petroleo {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .marca__clear {
    background: var(--ink);
    color: var(--on-dark, var(--cream));
    padding: 3.4rem 1.5rem 2.4rem;
  }

  .marca__clear h2,
  .marca__squares-copy h2,
  .marca__shared h2,
  .marca__rules h2 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
  }

  .marca__clear ul,
  .marca__rules ul,
  .marca__squares ul {
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .marca__clear li {
    padding: 0.95rem 0;
    border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .marca__clear li p {
    margin: 0;
  }

  .marca__clear li p:first-child {
    font-family: Fraunces, serif;
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .marca__clear li p:nth-child(2) {
    margin-top: 0.3rem;
    max-width: 28rem;
    font-size: 0.98rem;
    line-height: 1.4;
  }

  .marca__squares {
    background: var(--cream);
    color: var(--ink);
    padding: 3.4rem 1.5rem 2.6rem;
  }

  .marca__squares li img {
    display: block;
    width: 100%;
    height: auto;
  }

  .marca__squares li.is-crema img {
    box-shadow: inset 0 0 0 1.5px var(--forest);
  }

  .marca__squares .marca__files {
    padding: 0.85rem 0 1.3rem;
  }

  .marca__product.is-centia {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .marca__product.is-nervia {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .marca__product header {
    padding: 3.2rem 1.5rem 1.4rem;
  }

  .marca__product header img {
    display: block;
    width: min(100%, 18rem);
    height: auto;
  }

  .marca__shots {
    display: grid;
  }

  .marca__shots figure {
