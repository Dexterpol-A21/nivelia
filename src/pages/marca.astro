---
import Grainient from '@components/ui/Grainient.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { PAGES } from '@utils/constants';

const washOf = {
  crema: 'cream',
  bosque: 'forest',
  petroleo: 'petroleum',
  centia: 'forest',
  nervia: 'petroleum',
} as const;

const fieldOf = {
  crema: { name: 'Hueso', hex: '#F6F3EE' },
  bosque: { name: 'Azul', hex: '#0E6E9E' },
  petroleo: { name: 'Mora', hex: '#3E2770' },
} as const;

const plates = [
  {
    tone: 'crema',
    hero: true,
    name: 'Hueso',
    note: 'El uso de todos los días. El nombre va en tinta.',
  },
  {
    tone: 'bosque',
    name: 'Azul',
    note: 'Centia y el menú. El nombre va en hueso.',
  },
  {
    tone: 'petroleo',
    name: 'Mora',
    note: 'Nervia. El nombre va en hueso.',
  },
];

const clears = [
  {
    name: 'Tinta',
    note: 'Sobre hueso o foto clara.',
  },
  {
    name: 'Hueso',
    note: 'Sobre azul, mora o foto oscura.',
  },
  {
    name: 'Azul',
    note: 'Solo si el fondo ya es claro y no es hueso.',
  },
  {
    name: 'Mora',
    note: 'Solo si el fondo ya es claro y no es hueso.',
  },
];

const squares = [
  { tone: 'crema', name: 'Hueso' },
  { tone: 'bosque', name: 'Azul' },
  { tone: 'petroleo', name: 'Mora' },
];

const products = [
  {
    tone: 'centia',
    name: 'Centia',
    shots: [
      {
        src: '/centia.jpg?v=3',
        alt: 'Frasco Ekilia Centia con nopal, canela y cápsulas',
        caption: 'Frasco',
        wide: true,
      },
      {
        src: '/centia-botanica.png',
        alt: 'Nopal y canela sobre lino crema',
        caption: 'Origen botánico',
      },
      {
        src: '/centia-ingredientes.png?v=3',
        alt: 'Frasco Centia junto a cápsulas, nopal y canela',
        caption: 'La fórmula',
      },
      {
        src: '/centia-toma.png',
        alt: 'Dos cápsulas en el plato, con pan y hojas',
        caption: 'Con los alimentos',
      },
      {
        src: '/centia-manana.png?v=3',
        alt: 'Frasco Centia en la cocina, por la mañana',
        caption: 'Cada mañana',
      },
    ],
  },
  {
    tone: 'nervia',
    name: 'Nervia',
    shots: [
      {
        src: '/nervia.jpg?v=3',
        alt: 'Frasco Ekilia Nervia con pasiflora y cápsulas',
        caption: 'Frasco',
        wide: true,
      },
      {
        src: '/nervia-botanica.png',
        alt: 'Pasiflora sobre lino crema',
        caption: 'Origen botánico',
      },
      {
        src: '/nervia-ingredientes.png?v=3',
        alt: 'Frasco Nervia junto a cápsulas y pasiflora',
        caption: 'La fórmula',
      },
      {
        src: '/nervia-toma.png',
        alt: 'Dos cápsulas junto a una taza de té',
        caption: 'Con los alimentos',
      },
      {
        src: '/nervia-noche.png?v=3',
        alt: 'Frasco Nervia en la mesa de noche',
        caption: 'Al cerrar el día',
      },
    ],
  },
];

const shared = [
  {
    src: '/ritual-toma.png',
    alt: 'Dos cápsulas en un plato, junto al pan y las hojas',
    caption: 'La toma',
  },
  {
    src: '/cierre-frasco.png?v=3',
    alt: 'Un frasco en el umbral, listo para el mes siguiente',
    caption: 'El frasco que vuelve',
  },
];

const rules = [
  'Sobre hueso, el logotipo va en tinta. Sobre azul o mora, en hueso.',
  'No lo estires. No le cambies el color ni la letra.',
  'Sin sombra, sin contorno y sin esquinas redondas.',
  'Deja aire alrededor del logotipo. No lo pegues al borde de la pieza.',
  'Las fotos se usan enteras.',
];
---

<BaseLayout title={PAGES.marca.title} description={PAGES.marca.description}>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <article class="marca">
    <header class="marca__intro grain-host">
      <Grainient tone="forest" />
      <div>
        <h1>Marca.</h1>
        <p>
          El nombre va en Fraunces. Las fotos se bajan enteras. El color y el tipo están en el
          <a href="/sistema">sistema gráfico</a>.
        </p>
      </div>
    </header>

    <section class="marca__plates" aria-label="Logotipo">
      {
        plates.map((plate) => (
          <div class:list={['marca__plate', `is-${plate.tone}`, plate.hero && 'is-hero', 'grain-host']}>
            <Grainient tone={washOf[plate.tone]} />
            <p class="marca__mark">Ekilia</p>
            <div>
              <h2 data-field={plate.tone}>{fieldOf[plate.tone].name}</h2>
              <p><span data-hex={plate.tone}>{fieldOf[plate.tone].hex}</span>. {plate.note}</p>
            </div>
          </div>
        ))
      }
    </section>

    <section class="marca__clear grain-host" aria-label="Sin fondo">
      <Grainient tone="ink" />
      <div class="marca__clear-copy">
        <h2>Sobre foto</h2>
        <p>El nombre se compone en Fraunces. El color depende del fondo.</p>
      </div>
      <ul>
        {
          clears.map((item) => (
            <li>
              <p>{item.name}</p>
              <p>{item.note}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="marca__squares grain-host" aria-label="Cuadrado">
      <Grainient tone="cream" />
      <div class="marca__squares-copy">
        <h2>Cuadrado</h2>
        <p>Perfil, publicación y miniatura. 1600 px.</p>
      </div>
      <ul>
        {
          squares.map((item) => (
            <li class={`is-${item.tone}`}>
              <div class="marca__square-mark grain-host">
                <Grainient tone={washOf[item.tone]} />
                Ekilia
              </div>
              <p class="marca__files">{item.name}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="marca__products" aria-label="Nombres y fotos">
      {
        products.map((product) => (
          <div class={`marca__product is-${product.tone} grain-host`}>
            <Grainient tone={washOf[product.tone]} />
            <header>
              <p class="marca__name">{product.name}</p>
            </header>
            <div class="marca__shots">
              {product.shots.map((shot) => (
                <figure class:list={[shot.wide && 'is-wide']}>
                  <img src={shot.src} alt={shot.alt} />
                  <figcaption>
                    <span>{shot.caption}</span>
                    <a href={shot.src} download>
                      Descargar
                    </a>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="marca__shared grain-host" aria-label="Fotos de las dos fórmulas">
      <Grainient tone="cream" />
      <h2>Las dos fórmulas</h2>
      <div class="marca__shots">
        {
          shared.map((shot) => (
            <figure>
              <img src={shot.src} alt={shot.alt} />
              <figcaption>
                <span>{shot.caption}</span>
                <a href={shot.src} download>
                  Descargar
                </a>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="marca__rules grain-host" aria-label="Uso">
      <Grainient tone="ink" />
      <h2>Al usarlo</h2>
      <ul>
        {rules.map((rule) => <li>{rule}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .marca {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --petroleum: #3e2770;
    --ink: #1A1228;
    color: var(--ink);
  }

  .marca h2 {
    font-family: Fraunces, serif;
    margin: 0;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .marca a {
    color: inherit;
    font-weight: 600;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.18em;
  }

  .marca a:hover {
    text-decoration-thickness: 2.5px;
  }

  .marca a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .marca__files {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.15rem;
    margin: 0.9rem 0 0;
  }

  .marca__intro {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
    padding: 5.5rem 1.5rem 3.2rem;
  }

  .marca__intro h1 {
    font-family: Fraunces, serif;
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .marca__intro p {
    margin: 1rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .marca__mark,
  .marca__square-mark,
  .marca__name {
    font-family: Fraunces, serif;
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.8;
  }

  .marca__mark {
    font-optical-sizing: none;
    font-variation-settings: "opsz" 144, "wght" 600;
    font-size: clamp(3.2rem, 9vw, 5.4rem);
  }

  .marca__plate.is-hero .marca__mark {
    font-size: clamp(3.6rem, 11vw, 6.4rem);
  }

  .marca__square-mark {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--cream);
    color: var(--ink);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }

  .marca__squares li.is-bosque .marca__square-mark {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .marca__squares li.is-petroleo .marca__square-mark {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .marca__squares li.is-crema .marca__square-mark {
    box-shadow: inset 0 0 0 1.5px var(--forest);
  }

  .marca__name {
    font-weight: 500;
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: -0.04em;
    color: var(--on-dark, var(--cream));
  }

  .marca__plate {
    padding: 2.4rem 1.5rem 2.2rem;
  }

  .marca__plate.is-hero {
    padding-top: 3.2rem;
    padding-bottom: 2.8rem;
  }

  .marca__plate img {
    display: block;
    width: min(100%, 28rem);
    height: auto;
  }

  .marca__plate.is-hero img {
    width: min(100%, 52rem);
  }

  .marca__plate h2 {
    margin-top: 1.6rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .marca__plate p,
  .marca__clear-copy p,
  .marca__squares-copy p {
    margin: 0.55rem 0 0;
    max-width: 28rem;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .marca__plate.is-crema {
    background: var(--cream);
    color: var(--ink);
  }

  .marca__plate.is-bosque {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .marca__plate.is-petroleo {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .marca__clear {
    background: var(--ink);
    color: var(--on-dark, var(--cream));
    padding: 3.4rem 1.5rem 2.4rem;
  }

  .marca__clear h2,
  .marca__squares-copy h2,
  .marca__shared h2,
  .marca__rules h2 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
  }

  .marca__clear ul,
  .marca__rules ul,
  .marca__squares ul {
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .marca__clear li {
    padding: 0.95rem 0;
    border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .marca__clear li p {
    margin: 0;
  }

  .marca__clear li p:first-child {
    font-family: Fraunces, serif;
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .marca__clear li p:nth-child(2) {
    margin-top: 0.3rem;
    max-width: 28rem;
    font-size: 0.98rem;
    line-height: 1.4;
  }

  .marca__squares {
    background: var(--cream);
    color: var(--ink);
    padding: 3.4rem 1.5rem 2.6rem;
  }

  .marca__squares li img {
    display: block;
    width: 100%;
    height: auto;
  }

  .marca__squares li.is-crema img {
    box-shadow: inset 0 0 0 1.5px var(--forest);
  }

  .marca__squares .marca__files {
    padding: 0.85rem 0 1.3rem;
  }

  .marca__product.is-centia {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .marca__product.is-nervia {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .marca__product header {
    padding: 3.2rem 1.5rem 1.4rem;
  }

  .marca__product header img {
    display: block;
    width: min(100%, 18rem);
    height: auto;
  }

  .marca__shots {
    display: grid;
  }

  .marca__shots figure {
    margin: 0;
  }

  .marca__shots img {
    display: block;
    width: 100%;
    height: auto;
  }

  .marca__shots figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 1.5rem 1.15rem;
    font-size: 0.98rem;
  }

  .marca__shared {
    background: var(--cream);
    color: var(--ink);
    padding: 3.4rem 0 1rem;
  }

  .marca__shared h2 {
    padding: 0 1.5rem;
  }

  .marca__shared .marca__shots {
    margin-top: 1.4rem;
  }

  .marca__rules {
    background: var(--ink);
    color: var(--on-dark, var(--cream));
    padding: 3.4rem 1.5rem 3rem;
  }

  .marca__rules li {
    font-family: Fraunces, serif;
    max-width: 32rem;
    padding: 0.85rem 0;
    border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
    font-size: clamp(1.2rem, 2.6vw, 1.55rem);
    font-weight: 500;
    line-height: 1.25;
  }

  @media (min-width: 900px) {
    .marca__intro,
    .marca__clear,
    .marca__squares,
    .marca__rules {
      padding-left: 2.6rem;
      padding-right: 2.6rem;
    }

    .marca__intro {
      padding-top: 6.5rem;
      padding-bottom: 4rem;
    }

    .marca__plate {
      padding-left: 2.6rem;
      padding-right: 2.6rem;
    }

    .marca__plates {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .marca__plate.is-hero {
      grid-column: 1 / -1;
    }

    .marca__clear {
      display: grid;
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      gap: 2rem 3rem;
      align-items: start;
    }

    .marca__clear ul {
      margin-top: 0.4rem;
    }

    .marca__squares ul {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }

    .marca__products {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .marca__product header,
    .marca__shots figcaption {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .marca__shots {
      grid-template-columns: 1fr 1fr;
    }

    .marca__shots .is-wide {
      grid-column: 1 / -1;
    }

    .marca__shared {
      padding-top: 4rem;
    }

    .marca__shared h2 {
      padding-left: 2.6rem;
      padding-right: 2.6rem;
    }

    .marca__shared .marca__shots {
      grid-template-columns: 1fr 1fr;
    }

    .marca__shared figcaption {
      padding-left: 2.6rem;
      padding-right: 2.6rem;
    }
  }
</style>
