---
import Audience from '@components/home/Audience.astro';
import Choose from '@components/home/Choose.astro';
import Faq from '@components/home/Faq.astro';
import Formula from '@components/home/Formula.astro';
import HeroGlyv from '@components/home/HeroGlyv.astro';
import HomeCta from '@components/home/HomeCta.astro';
import HowItWorks from '@components/home/HowItWorks.astro';
import Paths from '@components/home/Paths.astro';
