---
import GlyvFlora from '@components/home/GlyvFlora.astro';
import GlyvButtons from '@components/ui/GlyvButtons.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { FACEBOOK, PAGES } from '@utils/constants';

const topics = [
  {
    title: 'El envase',
    body: 'Llegó dañado, incompleto o no es el que pediste.',
  },
  {
    title: 'La reposición',
    body: 'Pausar, cancelar o saber cuándo sale el siguiente frasco.',
  },
  {
    title: 'Tus datos',
    body: 'Pedir acceso, una corrección o que se borren.',
  },
] as const;
---

<BaseLayout title={PAGES.contacto.title} description={PAGES.contacto.description}>
  <article class="contact">
    <header class="contact__intro">
      <GlyvFlora variant="leaves" />
      <h1>Contacto.</h1>
      <p>Una duda, un pedido, una pausa. Glyv responde por Facebook.</p>
    </header>

    <section class="contact__topics" aria-label="Para qué escribir">
      <ul>
        {
          topics.map((topic) => (
            <li>
              <h2>{topic.title}</h2>
              <p>{topic.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="contact__face" aria-labelledby="contact-facebook">
      <h2 id="contact-facebook">Facebook</h2>
      <p>La conversación sigue allá. Envase, reposición o datos personales.</p>
      <GlyvButtons
        primary="Escribir en Facebook"
        primaryHref={FACEBOOK.href}
        primaryTarget="_blank"
        primaryRel="noopener noreferrer"
        secondary="Ver cómo funciona"
        secondaryHref="/como-funciona"
      />
    </section>
  </article>
</BaseLayout>

<style>
  .contact {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --petroleum: #0b4f6c;
    --ink: #1a2a22;
    font-family: Outfit, sans-serif;
  }

  .contact__intro,
  .contact__topics,
  .contact__face {
    padding: 2.4rem 1.5rem;
  }

  .contact__intro {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    color: var(--ink);
    padding-top: 6.5rem;
    padding-bottom: 2.6rem;
  }

  .contact__intro > :not(.glyv-flora) {
    position: relative;
    z-index: 1;
  }

  .contact__intro :global(.glyv-flora.is-ink-light .glyv-flora__clip.is-light) {
    display: none;
  }

  .contact__intro :global(.glyv-flora.is-ink-light .glyv-flora__clip.is-dark) {
    display: block;
    height: 100%;
  }

  .contact__intro :global(.glyv-flora.is-leaves) {
    inset: auto;
    top: 0;
    right: 0;
    width: min(92vw, 34rem);
    height: auto;
    aspect-ratio: 16 / 9;
  }

  .contact h1,
  .contact h2 {
    margin: 0;
    font-family: Fraunces, serif;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .contact h1 {
    font-size: clamp(3.2rem, 9vw, 5.6rem);
    line-height: 0.92;
  }

  .contact__intro p,
  .contact__face p,
  .contact__topics p {
    margin: 0.7rem 0 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .contact__intro p {
    margin-top: 1.15rem;
  }

  .contact__topics {
    background: var(--petroleum);
    color: var(--cream);
  }

  .contact__topics ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__topics li {
    max-width: 32rem;
    padding: 1.15rem 0 1.2rem;
    border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .contact__topics li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .contact__topics li:last-child {
    padding-bottom: 0;
  }

  .contact__topics h2 {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    line-height: 1.05;
  }

  .contact__topics p {
    opacity: 0.86;
  }

  .contact__face {
    position: relative;
    background: var(--forest);
    color: var(--cream);
  }

  .contact__face :global(.glyv-btns) {
    margin-bottom: 0.2rem;
  }

  .contact__face h2 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 0.95;
  }

  @media (min-width: 900px) {
    .contact__intro,
    .contact__topics,
    .contact__face {
      padding-left: 2.6rem;
      padding-right: 2.6rem;
    }

    .contact__intro {
      padding-top: 8rem;
      padding-bottom: 3rem;
    }

    .contact__face {
      padding-bottom: 2.8rem;
    }
  }
</style>
