---
import EkiliaButtons from '@components/ui/EkiliaButtons.astro';
import Grainient from '@components/ui/Grainient.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { CONTACT, FACEBOOK, PAGES } from '@utils/constants';

const topics = [
  {
    title: 'El envase',
    body: 'Llegó dañado, incompleto o no es el que pediste.',
  },
  {
    title: 'La reposición',
    body: 'Pausar, cancelar o saber cuándo sale el siguiente frasco.',
  },
  {
    title: 'Tus datos',
    body: 'Pedir acceso, una corrección o que se borren.',
  },
] as const;
---

<BaseLayout title={PAGES.contacto.title} description={PAGES.contacto.description}>
  <article class="contact">
    <header class="contact__intro grain-host">
      <Grainient tone="cream" />
      <h1>Contacto.</h1>
      <p>Una duda, un pedido, una pausa. Escribe a <a href={CONTACT.href}>{CONTACT.email}</a>.</p>
    </header>

    <section class="contact__topics grain-host" aria-label="Para qué escribir">
      <Grainient tone="petroleum" />
      <ul>
        {
          topics.map((topic) => (
            <li>
              <h2>{topic.title}</h2>
              <p>{topic.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="contact__face grain-host" aria-labelledby="contact-mail">
      <Grainient tone="forest" />
      <h2 id="contact-mail">Correo</h2>
      <p><a class="contact__mail" href={CONTACT.href}>{CONTACT.email}</a></p>
      <p>Envase, reposición o datos personales. La conversación también sigue en Facebook.</p>
      <EkiliaButtons
        primary="Escribir"
        primaryHref={CONTACT.href}
        secondary="Escribir en Facebook"
        secondaryHref={FACEBOOK.href}
        secondaryTarget="_blank"
        secondaryRel="noopener noreferrer"
      />
    </section>
  </article>
</BaseLayout>

<style>
  .contact {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --petroleum: #3e2770;
    --ink: #1A1228;
  }

  .contact__intro,
  .contact__topics,
  .contact__face {
    padding: 2.4rem 1.5rem;
  }

  .contact__intro {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    color: var(--ink);
    padding-top: 6.5rem;
    padding-bottom: 2.6rem;
  }

  .contact__intro > :not(.ekilia-flora) {
    position: relative;
    z-index: 1;
  }

  .contact h1,
  .contact h2 {
    font-family: Fraunces, serif;
    margin: 0;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .contact h1 {
    font-size: clamp(3.2rem, 9vw, 5.6rem);
    line-height: 0.92;
  }

  .contact__intro p,
  .contact__face p,
  .contact__topics p {
    margin: 0.7rem 0 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .contact__intro p {
    margin-top: 1.15rem;
  }

  .contact__intro a,
  .contact__mail {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .contact__mail {
    display: inline-block;
    margin-top: 0.35rem;
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    overflow-wrap: anywhere;
  }

  .contact__intro a:hover,
  .contact__intro a:focus-visible,
  .contact__mail:hover,
  .contact__mail:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .contact a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .contact__topics {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .contact__topics ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__topics li {
    min-width: 0;
    padding: 0 1.15rem;
    border-left: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .contact__topics li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .contact__topics li:last-child {
    padding-right: 0;
  }

  .contact__topics h2 {
    font-size: clamp(1.35rem, 2.4vw, 2.15rem);
    line-height: 1.05;
  }

  .contact__topics p {
    max-width: none;
    opacity: 0.86;
  }

  @media (max-width: 639px) {
    .contact__topics ul {
      grid-template-columns: 1fr;
    }

    .contact__topics li {
      padding: 1.15rem 0 1.2rem;
      border-left: 0;
      border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
    }

    .contact__topics li:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .contact__topics li:last-child {
      padding-bottom: 0;
    }

    .contact__topics h2 {
      font-size: clamp(1.7rem, 4vw, 2.4rem);
    }
  }

  .contact__face {
    --bloom: var(--forest);
    position: relative;
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .contact__face :global(.ekilia-btns) {
    margin-bottom: 0.2rem;
  }

  .contact__face h2 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 0.95;
  }

  @media (min-width: 900px) {
    .contact__intro,
    .contact__topics,
    .contact__face {
      padding-left: 2.6rem;
      padding-right: 2.6rem;
    }

    .contact__intro {
      padding-top: 8rem;
      padding-bottom: 3rem;
    }

    .contact__face {
      padding-bottom: 2.8rem;
    }
  }
</style>
