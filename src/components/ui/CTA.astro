---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
}

const { href, label, variant = 'primary' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-12 items-center justify-center rounded-xl px-8 py-3.5 text-base font-semibold transition-colors',
    variant === 'primary' && 'bg-primary text-white hover:bg-primary-dark',
    variant === 'secondary' && 'border border-border bg-surface text-text hover:border-primary',
  ]}
>
  {label}
</a>
