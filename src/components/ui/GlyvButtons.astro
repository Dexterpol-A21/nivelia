---
interface Props {
  primary: string;
  secondary: string;
  primaryHref?: string;
  secondaryHref?: string;
  class?: string;
}

const {
  primary,
  secondary,
  primaryHref = '/contacto',
  secondaryHref = '/servicios',
  class: className,
} = Astro.props;

const secondaryChars = [...secondary];
---

<div class:list={['glyv-btns', className]}>
  <a class="glyv-btns__btn is-bloom" href={primaryHref}>
    <span class="glyv-btns__bloom" aria-hidden="true">
      <span class="glyv-btns__layers">
        <span class="glyv-btns__layer is-1"></span>
        <span class="glyv-btns__layer is-2"></span>
        <span class="glyv-btns__layer is-3"></span>
      </span>
    </span>
    <span class="glyv-btns__inner">
      <span class="glyv-btns__static">{primary}</span>
      <span class="glyv-btns__hover-label">{primary}</span>
    </span>
  </a>
  <a class="glyv-btns__btn is-tinta" href={secondaryHref} aria-label={secondary}>
    <span class="glyv-btns__swap" aria-hidden="true">
      <span class="glyv-btns__text">
        {
          secondaryChars.map((char) => (
            <span>{char === ' ' ? '\u00a0' : char}</span>
          ))
        }
      </span>
      <span class="glyv-btns__clone">
        {
          secondaryChars.map((char, i) => (
            <span style={`transition-delay: ${0.04 + i * 0.03}s`}>
              {char === ' ' ? '\u00a0' : char}
            </span>
          ))
        }
      </span>
    </span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </a>
</div>

<style>
  .glyv-btns {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --hover: 0.48s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
    font-family: Outfit, sans-serif;
  }

  .glyv-btns__btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.35rem;
    border-radius: 0;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .glyv-btns__btn:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 3px;
  }

  .glyv-btns__btn.is-bloom {
    overflow: hidden;
    background: transparent;
    color: var(--cream);
    box-shadow: inset 0 0 0 2px var(--cream);
    padding: 0.8rem 1.5rem;
  }

  .glyv-btns__bloom {
    pointer-events: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .glyv-btns__layers {
    position: absolute;
    left: 50%;
    top: -60%;
    width: max(220%, 10rem);
    aspect-ratio: 1;
    transform: translate(-50%);
  }

  .glyv-btns__layer {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform: scale(0);
    transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .glyv-btns__layer.is-1 {
    background: #ebe4d4;
  }

  .glyv-btns__layer.is-2,
  .glyv-btns__layer.is-3 {
    background: var(--cream);
  }

  .glyv-btns__btn.is-bloom:hover .glyv-btns__layer.is-1,
  .glyv-btns__btn.is-bloom:focus-visible .glyv-btns__layer.is-1 {
    transform: scale(1);
  }

  .glyv-btns__btn.is-bloom:hover .glyv-btns__layer.is-2,
  .glyv-btns__btn.is-bloom:focus-visible .glyv-btns__layer.is-2 {
    transform: scale(1);
    transition-delay: 0.12s;
  }

  .glyv-btns__btn.is-bloom:hover .glyv-btns__layer.is-3,
  .glyv-btns__btn.is-bloom:focus-visible .glyv-btns__layer.is-3 {
    transform: scale(1);
    transition-delay: 0.24s;
  }

  .glyv-btns__inner {
    position: relative;
    z-index: 1;
    display: grid;
  }

  .glyv-btns__static,
  .glyv-btns__hover-label {
    grid-area: 1 / 1;
    transition:
      transform 1.1s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.35s linear;
  }

  .glyv-btns__hover-label {
    opacity: 0;
    color: var(--forest);
    transform: translateY(70%);
  }

  .glyv-btns__btn.is-bloom:hover .glyv-btns__static,
  .glyv-btns__btn.is-bloom:focus-visible .glyv-btns__static {
    opacity: 0;
    transform: translateY(-70%);
  }

  .glyv-btns__btn.is-bloom:hover .glyv-btns__hover-label,
  .glyv-btns__btn.is-bloom:focus-visible .glyv-btns__hover-label {
    opacity: 1;
    transform: translateY(0);
  }

  .glyv-btns__btn.is-tinta {
    overflow: visible;
    background: none;
    color: var(--cream);
    gap: 0.45rem;
    padding: 0.8rem 0.2rem 0.55rem 0.15rem;
  }

  .glyv-btns__btn.is-tinta .glyv-btns__swap {
    overflow: hidden;
  }

  .glyv-btns__btn.is-tinta svg {
    position: relative;
    z-index: 2;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: rotate(-50deg);
    transition: transform var(--hover);
  }

  .glyv-btns__btn.is-tinta:hover svg,
  .glyv-btns__btn.is-tinta:focus-visible svg {
    transform: rotate(0deg);
  }

  .glyv-btns__btn.is-tinta::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--hover);
  }

  .glyv-btns__btn.is-tinta:hover::before,
  .glyv-btns__btn.is-tinta:focus-visible::before {
    transform: scaleX(1);
    transform-origin: left;
  }

  .glyv-btns__swap {
    position: relative;
    display: grid;
  }

  .glyv-btns__text,
  .glyv-btns__clone {
    display: flex;
    grid-area: 1 / 1;
  }

  .glyv-btns__text span,
  .glyv-btns__clone span {
    display: block;
    transition: transform var(--hover);
  }

  .glyv-btns__clone span {
    transform: translateY(2.4rem);
  }

  .glyv-btns__btn.is-tinta:hover .glyv-btns__text span,
  .glyv-btns__btn.is-tinta:focus-visible .glyv-btns__text span {
    transform: translateY(-2.4rem);
  }

  .glyv-btns__btn.is-tinta:hover .glyv-btns__clone span,
  .glyv-btns__btn.is-tinta:focus-visible .glyv-btns__clone span {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .glyv-btns__text span,
    .glyv-btns__clone span,
    .glyv-btns__static,
    .glyv-btns__hover-label,
    .glyv-btns__layer {
      transform: none !important;
      transition: none;
      transition-delay: 0s !important;
    }

    .glyv-btns__clone,
    .glyv-btns__hover-label {
      display: none;
    }

    .glyv-btns__btn.is-bloom:hover,
    .glyv-btns__btn.is-bloom:focus-visible {
      background: var(--cream);
      color: var(--forest);
    }
  }
</style>
