---
interface Props {
  step: 'eliges' | 'llega' | 'repite';
}

const { step } = Astro.props;
---

<div class:list={['step-mark', `is-${step}`]} aria-hidden="true">
  {
    step === 'eliges' && (
      <>
        <span class="jar"></span>
        <span class="jar is-wave"></span>
      </>
    )
  }
  {
    step === 'llega' && (
      <>
        <span class="ticks">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="jar"></span>
        <span class="arrow"></span>
        <span class="door"></span>
      </>
    )
  }
  {
    step === 'repite' && (
      <span class="cycle">
        <span class="jar"></span>
      </span>
    )
  }
</div>

<style>
  .step-mark {
    --mark: #f4efe6;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--mark);
  }

  .jar {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 2.35rem;
    height: 3.7rem;
    border: 2px solid var(--mark);
  }

  .jar::before {
    content: '';
    position: absolute;
    top: -0.62rem;
    left: 50%;
    width: 1.25rem;
    height: 0.52rem;
    border: 2px solid var(--mark);
    transform: translateX(-50%);
  }

  .jar::after {
    content: '';
    position: absolute;
    top: 0.8rem;
    left: 0.38rem;
    right: 0.38rem;
    height: 2px;
    background: var(--mark);
  }

  .is-wave::after {
    top: 0.95rem;
    left: 0.28rem;
    right: 0.28rem;
    height: 0.75rem;
    background: none;
    border-top: 2px solid var(--mark);
    border-radius: 0 0 40% 40%;
  }

  .ticks {
    display: grid;
    gap: 0.38rem;
  }

  .ticks span {
    display: block;
    height: 2px;
    background: var(--mark);
  }

  .ticks span:nth-child(1) {
    width: 0.8rem;
  }

  .ticks span:nth-child(2) {
    width: 1.2rem;
  }

  .ticks span:nth-child(3) {
    width: 0.65rem;
  }

  .arrow {
    position: relative;
    width: 1.2rem;
    height: 2px;
    background: var(--mark);
  }

  .arrow::before {
    content: '';
    position: absolute;
    top: 50%;
    right: -0.02rem;
    width: 0.55rem;
    height: 0.55rem;
    border-top: 2px solid var(--mark);
    border-right: 2px solid var(--mark);
    transform: translateY(-50%) rotate(45deg);
  }

  .door {
    position: relative;
    width: 1.25rem;
    height: 3.35rem;
    border: 2px solid var(--mark);
  }

  .door::before {
    content: '';
    position: absolute;
    inset: 0.28rem 0.22rem 0;
    border: 2px solid var(--mark);
    border-bottom: 0;
  }

  .door::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 0.26rem;
    width: 0.38rem;
    height: 2px;
    background: var(--mark);
  }

  .cycle {
    position: relative;
    display: grid;
    width: 4.4rem;
    height: 4.4rem;
    place-items: center;
    border: 2px solid var(--mark);
    border-radius: 50%;
  }

  .cycle .jar {
    width: 1.35rem;
    height: 2rem;
  }

  .cycle .jar::before {
    top: -0.42rem;
    width: 0.75rem;
    height: 0.34rem;
  }

  .cycle::before,
  .cycle::after {
    content: '';
    position: absolute;
    box-sizing: border-box;
  }

  .cycle::before {
    top: -0.12rem;
    right: 0.55rem;
    width: 1.55rem;
    height: 1.55rem;
    border: 2px solid transparent;
    border-top-color: var(--mark);
    border-right-color: var(--mark);
    border-radius: 50%;
    transform: rotate(18deg);
  }

  .cycle::after {
    top: 0.18rem;
    right: 0.42rem;
    width: 0.48rem;
    height: 0.48rem;
    border-top: 2px solid var(--mark);
    border-right: 2px solid var(--mark);
    transform: rotate(55deg);
  }
</style>
