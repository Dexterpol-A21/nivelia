---
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.paths;
const tones = ['is-forest', 'is-petroleum', 'is-forest'] as const;
---

<section class="home-paths" aria-labelledby="home-paths-title">
  <h2 id="home-paths-title">{copy.h2}</h2>
  <div>
    {
      copy.items.map((item, i) => (
        <a class={`home-paths__plate ${tones[i]}`} href={item.href}>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .home-paths {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --petroleum: #0b4f6c;
    --ink: #1a2a22;
    font-family: Outfit, sans-serif;
  }

  .home-paths > h2 {
    margin: 0;
    padding: 3.2rem 1.5rem 1.6rem;
    background: var(--cream);
    color: var(--ink);
    font-family: Fraunces, serif;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-paths > div {
    display: grid;
  }

  .home-paths__plate {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 16rem;
    padding: 2.2rem 1.5rem 2rem;
    color: var(--cream);
    text-decoration: none;
  }

  .is-forest {
    background: var(--forest);
  }

  .is-petroleum {
    background: var(--petroleum);
  }

  .home-paths h3 {
    margin: 0;
    font-family: Fraunces, serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .home-paths p {
    margin: 0.7rem 0 0;
    max-width: 22ch;
    font-size: 1.02rem;
    line-height: 1.45;
    opacity: 0.86;
  }

  .home-paths span {
    margin-top: 1.2rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .home-paths__plate:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: -6px;
  }

  @media (min-width: 900px) {
    .home-paths > h2 {
      padding: 3.6rem 2.6rem 1.8rem;
    }

    .home-paths > div {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .home-paths__plate {
      min-height: 22rem;
      padding: 2.6rem 2.2rem;
    }
  }
</style>
