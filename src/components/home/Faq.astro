---
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.faq;
---

<section class="home-faq" id="faq" aria-labelledby="home-faq-title">
  <h2 id="home-faq-title">{copy.h2}</h2>
  <div>
    {
      copy.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .home-faq {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --ink: #1a2a22;
    background: var(--cream);
    color: var(--ink);
    padding: 3.2rem 1.5rem 3rem;
    font-family: Outfit, sans-serif;
  }

  .home-faq h2 {
    margin: 0 0 1.6rem;
    font-family: Fraunces, serif;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-faq details {
    border-top: 1.5px solid var(--forest);
  }

  .home-faq details:last-child {
    border-bottom: 1.5px solid var(--forest);
  }

  .home-faq summary {
    position: relative;
    cursor: pointer;
    list-style: none;
    padding: 1.05rem 2.2rem 1.05rem 0;
    font-family: Fraunces, serif;
    font-size: clamp(1.2rem, 2.6vw, 1.55rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .home-faq summary::-webkit-details-marker {
    display: none;
  }

  .home-faq summary::after {
    content: '+';
    position: absolute;
    right: 0;
    font-family: Outfit, sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .home-faq details {
    position: relative;
  }

  .home-faq details[open] summary::after {
    content: '–';
  }

  .home-faq summary:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 4px;
  }

  .home-faq p {
    margin: 0;
    padding: 0 0 1.2rem;
    max-width: 38rem;
    font-size: 1.02rem;
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .home-faq {
      padding: 3.6rem 2.6rem 3.2rem;
    }

    .home-faq summary::after {
      right: 0;
    }
  }
</style>
