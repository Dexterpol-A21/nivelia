---
import GlyvFlora from '@components/home/GlyvFlora.astro';
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.faq;
---

<div data-slide-host>
<section class="home-faq" id="faq" data-slide="right" aria-labelledby="home-faq-title">
  <GlyvFlora variant="seam" ink="light" />
  <GlyvFlora variant="leaves" />
  <h2 id="home-faq-title">{copy.h2}</h2>
  <div>
    {
      copy.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <div class="faq-a">
            <div>
              <p>{item.a}</p>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>
</div>

<style>
  .home-faq {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --ink: #1a2a22;
    --flora-seam-h: 4.2rem;
    background: var(--forest);
    color: var(--cream);
    padding: 4.8rem 1.5rem 3rem;
    position: relative;
    overflow: hidden;
    font-family: Outfit, sans-serif;
  }

  .home-faq > :not(.glyv-flora) {
    position: relative;
    z-index: 1;
  }

  .home-faq h2 {
    margin: 0 0 1.6rem;
    font-family: Fraunces, serif;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-faq details {
    border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .home-faq details:last-child {
    border-bottom: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .home-faq summary {
    position: relative;
    cursor: pointer;
    list-style: none;
    padding: 1.05rem 2.2rem 1.05rem 0;
    font-family: Fraunces, serif;
    font-size: clamp(1.2rem, 2.6vw, 1.55rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .home-faq summary::-webkit-details-marker {
    display: none;
  }

  .home-faq summary::after {
    content: '+';
    position: absolute;
    right: 0;
    font-family: Outfit, sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .home-faq details {
    position: relative;
  }

  .home-faq details.is-open summary::after {
    content: '–';
  }

  .home-faq details.is-closing summary::after {
    content: '+';
  }

  .home-faq details::details-content {
    content-visibility: visible;
  }

  .home-faq .faq-a {
    display: block;
    height: 0;
    overflow: hidden;
    opacity: 0;
  }

  .home-faq .faq-a p {
    transform: translateY(-0.4rem);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-faq details.is-open > .faq-a p {
    transform: none;
  }

  .home-faq details.is-closing > .faq-a p {
    transform: translateY(-0.4rem);
    transition-duration: 0.36s;
  }

  .home-faq summary:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 4px;
  }

  .home-faq p {
    margin: 0;
    padding: 0 0 1.2rem;
    max-width: 38rem;
    font-size: 1.02rem;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq details[open] > .faq-a {
      height: auto;
      opacity: 1;
      overflow: visible;
    }

    .home-faq details[open] summary::after {
      content: '–';
    }

    .home-faq .faq-a p {
      transform: none;
      transition: none;
    }
  }

  @media (min-width: 900px) {
    .home-faq {
      --flora-seam-h: 4.6rem;
      padding: 5.3rem 2.6rem 3.2rem;
    }

    .home-faq summary::after {
      right: 0;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const openEase = 'height 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.34s ease 0.04s';
  const closeEase = 'height 0.36s cubic-bezier(0.4, 0, 1, 1), opacity 0.22s ease';

  if (!reduceMotion) {
    document.querySelectorAll('.home-faq details').forEach((details) => {
      const summary = details.querySelector('summary');
      const body = details.querySelector('.faq-a');
      const inner = body?.firstElementChild;
      if (!summary || !body || !inner) return;

      let generation = 0;

      const paintOpen = (run: number) => {
        if (run !== generation) return;
        const target = inner.scrollHeight;
        body.style.transition = openEase;
        body.style.height = `${target}px`;
        body.style.opacity = '1';
        details.classList.add('is-open');
      };

      const open = () => {
        const run = ++generation;
        details.classList.remove('is-closing');
        details.open = true;
        body.style.transition = 'none';
        body.style.height = '0px';
        body.style.opacity = '0';
        body.style.overflow = 'hidden';
        void body.offsetHeight;
        requestAnimationFrame(() => requestAnimationFrame(() => paintOpen(run)));

        const onEnd = (event: TransitionEvent) => {
          if (event.target !== body || event.propertyName !== 'height' || run !== generation) return;
          body.removeEventListener('transitionend', onEnd);
          body.style.height = 'auto';
        };
        body.addEventListener('transitionend', onEnd);
      };

      const close = () => {
        const run = ++generation;
        let settled = false;
        const current = body.getBoundingClientRect().height;
        details.classList.remove('is-open');
        details.classList.add('is-closing');
        body.style.transition = 'none';
        body.style.height = `${current}px`;
        body.style.overflow = 'hidden';
        void body.offsetHeight;
        body.style.transition = closeEase;
        body.style.height = '0px';
        body.style.opacity = '0';

        const finish = () => {
          if (settled || run !== generation) return;
          settled = true;
          details.open = false;
          details.classList.remove('is-closing');
          body.style.transition = 'none';
          body.style.height = '0px';
          body.style.opacity = '0';
        };

        const onEnd = (event: TransitionEvent) => {
          if (event.target !== body || event.propertyName !== 'height') return;
          body.removeEventListener('transitionend', onEnd);
          finish();
        };
        body.addEventListener('transitionend', onEnd);
        window.setTimeout(finish, 420);
      };

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        if (details.open) close();
        else open();
      });
    });
  }
</script>
