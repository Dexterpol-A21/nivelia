---
import EkiliaButtons from '@components/ui/EkiliaButtons.astro';
import Grainient from '@components/ui/Grainient.astro';
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.close;
---

<div data-slide-host>
<section class="home-close grain-host" data-slide="left" aria-labelledby="home-close-title">
  <Grainient tone="cream" />
  <div class="home-close__copy">
    <h2 id="home-close-title">{copy.h2}</h2>
    <p>{copy.body}</p>
    <EkiliaButtons
      primary={copy.primary}
      primaryHref="/reposicion"
      secondary={copy.secondary}
      secondaryHref="/centia"
    />
  </div>
  <figure class="home-close__photo">
    <img
      src="/cierre-frasco.png?v=3"
      alt="Un frasco en el umbral, listo para el mes siguiente"
      width="1200"
      height="900"
    />
  </figure>
</section>
</div>

<style>
  .home-close {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --ink: #1A1228;
    --bloom: var(--forest);
    --bloom-ink: var(--forest);
    background: var(--cream);
    color: var(--ink);
    padding: 7.6rem 1.5rem 3.2rem;
    position: relative;
    overflow: hidden;
  }

  .home-close > :not(.ekilia-flora) {
    position: relative;
    z-index: 1;
  }

  .home-close__photo {
    margin: 1.6rem 0 0;
  }

  .home-close__photo img {
    display: block;
    width: 100%;
    height: 16rem;
    object-fit: cover;
  }

  .home-close h2 {
    font-family: Fraunces, serif;
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .home-close p {
    margin: 1.1rem 0 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .home-close :global(.ekilia-btns__btn.is-bloom) {
    color: var(--forest);
    box-shadow: inset 0 0 0 2px var(--forest);
  }

  .home-close :global(.ekilia-btns__btn.is-tinta) {
    color: var(--forest);
  }

  .home-close :global(.ekilia-btns__btn:focus-visible) {
    outline-color: var(--forest);
  }

  @media (min-width: 900px) {
    .home-close {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2rem;
      align-items: end;
      padding: 8.4rem 2.6rem 3.6rem;
    }

    .home-close__photo {
      margin: 0;
      align-self: stretch;
    }

    .home-close__photo img {
      height: 100%;
      min-height: 18rem;
    }
  }
</style>
