---
import EkiliaButtons from '@components/ui/EkiliaButtons.astro';
import Grainient from '@components/ui/Grainient.astro';
import { HERO } from '@utils/constants';

const copy = HERO;
const h1Break = copy.h1.split(' para ');
const bandBreak = copy.band.split(' del ');
---

<section id="hero-ekilia" class="hero-ekilia" aria-label="Ekilia">
  <div class="hero-ekilia__stage">
  <div class="hero-ekilia__cream grain-host">
    <div class="hero-ekilia__own">
      <Grainient tone="hero-bone" />
    </div>
    <p class="hero-ekilia__wordmark animate-in">{copy.wordmark}</p>
  </div>

  <div class="hero-ekilia__forest grain-host">
    <div class="hero-ekilia__own">
      <Grainient tone="hero-blue" />
    </div>
    <h1 class="animate-in">
      {h1Break[0]} para<br />{h1Break[1]}
    </h1>
    <p class="hero-ekilia__body animate-in">{copy.body}</p>
  </div>
  </div>

  <div class="hero-ekilia__petroleum grain-host">
    <Grainient tone="turquoise" />
    <div class="hero-ekilia__lead">
      <p class="hero-ekilia__band">
        {bandBreak[0]}<br />del {bandBreak[1]}
      </p>
      <p class="hero-ekilia__note">{copy.bandNote}</p>
    </div>
    <dl>
      {
        copy.specs.map((spec) => (
          <div>
            <dt>{spec.k}</dt>
            <dd>{spec.v}</dd>
          </div>
        ))
      }
    </dl>
    <EkiliaButtons primary={copy.cta} secondary={copy.secondary} primaryHref="/reposicion" />
  </div>
</section>

<style>
  .hero-ekilia {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --petroleum: #3e2770;
    --turquoise-deep: #0f6468;
    --ink: #1A1228;
    --cols: 1fr 1fr;
    --flora-bottom: 7.4rem;
    --flora-main-h: max(7.5rem, 11.25vw);
    --flora-main-h-desktop: max(10.5rem, 11.25vw);
    --flora-bottom-h: 10.5rem;
    position: relative;
    display: grid;
  }

  .hero-ekilia__stage {
    position: relative;
    display: grid;
    min-height: 70vh;
  }

  .hero-ekilia__own {
    position: absolute;
    inset: 0;
    z-index: -1 !important;
    pointer-events: none;
  }

  .hero-ekilia__cream,
  .hero-ekilia__forest,
  .hero-ekilia__petroleum {
    position: relative;
    z-index: 1;
    padding: 1.5rem 1.35rem;
  }

  .hero-ekilia__forest > :not(.ekilia-flora),
  .hero-ekilia__petroleum > :not(.ekilia-nerves) {
    position: relative;
    z-index: 1;
  }

  .hero-ekilia__petroleum {
    overflow: hidden;
  }

  .hero-ekilia__cream {
    overflow: hidden;
    background: var(--cream);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: max(1.5rem, env(safe-area-inset-top, 0px));
  }

  .hero-ekilia__wordmark {
    font-family: "Fraunces", serif;
    font-optical-sizing: none;
    font-variation-settings: "opsz" 144, "wght" 600;
    margin: auto 0;
    font-size: clamp(3.2rem, 12vw, 6.8rem);
    font-weight: 600;
    line-height: 0.78;
    letter-spacing: -0.05em;
  }

  .hero-ekilia__forest {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
    overflow: hidden;
    display: grid;
    align-content: start;
  }

  .hero-ekilia h1 {
    font-family: Fraunces, serif;
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.15rem, 6vw, 4.2rem);
    font-weight: 500;
    line-height: 0.98;
  }

  .hero-ekilia__body {
    margin: 1.15rem 0 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.55;
    opacity: 0.88;
  }

  .hero-ekilia__petroleum {
    --bloom: var(--band, var(--turquoise, #0f6468));
    background: var(--band, var(--turquoise-deep, var(--petroleum)));
    color: var(--on-dark, var(--cream));
  }

  .hero-ekilia__band {
    font-family: Fraunces, serif;
    margin: 0;
    max-width: 16em;
    font-size: clamp(1.7rem, 3.8vw, 2.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero-ekilia__note {
    margin: 0.7rem 0 0;
    max-width: 36rem;
    font-size: 1.02rem;
    line-height: 1.45;
    opacity: 0.88;
  }

  .hero-ekilia dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem 1.15rem;
    margin: 1.75rem 0 0;
  }

  .hero-ekilia dt {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.78;
  }

  .hero-ekilia dd {
    font-family: Fraunces, serif;
    margin: 0.28rem 0 0;
    font-size: clamp(1.45rem, 5.4vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    white-space: nowrap;
  }

  .hero-ekilia__petroleum :global(.ekilia-btns) {
    margin-top: 1.75rem;
  }

  @media (min-width: 900px) {
    .hero-ekilia {
      grid-template-columns: var(--cols);
      grid-template-rows: 1fr auto;
      min-height: calc(100dvh - var(--nav-dock, 0px));
    }

    .hero-ekilia__stage {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
      min-height: 0;
      height: 100%;
    }

    .hero-ekilia__cream {
      padding-top: 3.2rem;
    }

    .hero-ekilia__forest {
      align-content: center;
      padding-right: 2.6rem;
    }

    .hero-ekilia__petroleum {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: var(--cols);
      gap: 1.35rem 2rem;
      padding: 1.7rem 2.2rem 1.85rem;
      align-items: center;
    }

    .hero-ekilia__petroleum :global(.ekilia-btns) {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .hero-ekilia__band {
      margin: 0;
    }

    .hero-ekilia dl {
      grid-template-columns: repeat(4, max-content);
      justify-content: space-between;
      gap: 0.45rem 0.7rem;
      margin: 0;
    }

    .hero-ekilia dd {
      font-size: clamp(1.32rem, 2.1vw, 1.9rem);
    }
  }
</style>
