---
import GlyvFlora from '@components/home/GlyvFlora.astro';
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.ritual;
---

<div data-slide-host>
<section class="home-ritual" data-slide="left" aria-labelledby="home-ritual-title">
  <GlyvFlora variant="seam" ink="light" />
  <div class="home-ritual__copy">
    <h2 id="home-ritual-title">{copy.h2}</h2>
    <p class="home-ritual__same">{copy.same}</p>
    <dl>
      {
        copy.specs.map((spec) => (
          <div>
            <dt>{spec.k}</dt>
            <dd>{spec.v}</dd>
          </div>
        ))
      }
    </dl>
    <p>{copy.note}</p>
    <figure class="home-ritual__photo">
      <img
        src="/ritual-toma.png"
        alt="Dos cápsulas en un plato, junto al pan y las hojas"
        width="1200"
        height="900"
      />
    </figure>
  </div>
</section>
</div>

<style>
  .home-ritual {
    --cream: #f4efe6;
    --petroleum: #0b4f6c;
    --flora-seam-h: 4.2rem;
    background: var(--petroleum);
    color: var(--cream);
    padding: 4.6rem 1.5rem 2.4rem;
    position: relative;
    overflow: hidden;
    font-family: Outfit, sans-serif;
  }

  .home-ritual__copy {
    position: relative;
    z-index: 1;
  }

  .home-ritual h2 {
    margin: 0;
    font-family: Fraunces, serif;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-ritual dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem 1.4rem;
    margin: 1.4rem 0 0;
  }

  .home-ritual dt {
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.7;
  }

  .home-ritual dd {
    margin: 0.25rem 0 0;
    font-family: Fraunces, serif;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 500;
  }

  .home-ritual__same {
    margin: 0.75rem 0 0;
    max-width: 28rem;
    font-family: Fraunces, serif;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .home-ritual__copy > p:not(.home-ritual__same) {
    margin: 1.4rem 0 0;
    max-width: 36rem;
    font-size: 0.98rem;
    line-height: 1.5;
    opacity: 0.86;
  }

  .home-ritual__photo {
    margin: 1.5rem 0 0;
  }

  .home-ritual__photo img {
    display: block;
    width: 100%;
    height: 14rem;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .home-ritual {
      padding: 5rem 2.6rem 2.2rem;
    }

    .home-ritual__copy {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 1.2rem 2rem;
      align-items: end;
    }

    .home-ritual h2,
    .home-ritual__same,
    .home-ritual dl,
    .home-ritual__copy > p:not(.home-ritual__same) {
      grid-column: 1;
    }

    .home-ritual__photo {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      align-self: stretch;
    }

    .home-ritual__photo img {
      height: 100%;
      min-height: 16rem;
    }

    .home-ritual__same {
      margin-top: 0.35rem;
    }

    .home-ritual dl {
      margin-top: 0;
    }

    .home-ritual__copy > p:not(.home-ritual__same) {
      margin-top: 0;
    }
  }
</style>
