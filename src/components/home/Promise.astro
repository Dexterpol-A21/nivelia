---
import Grainient from '@components/ui/Grainient.astro';
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.promise;
---

<section class="home-promise" data-slide-host aria-labelledby="home-promise-title">
  <div class="home-promise__cream grain-host" data-slide="left">
    <Grainient tone="cream" />
    <h2 id="home-promise-title">{copy.h2}</h2>
    <p>{copy.left}</p>
  </div>
  <div class="home-promise__forest grain-host" data-slide="right">
    <Grainient tone="forest" />
    <div class="home-promise__lead">
      <h3>{copy.rightTitle}</h3>
      <p class="home-promise__claim">{copy.rightClaim}</p>
    </div>
    <div class="home-promise__act">
      <p>{copy.right}</p>
    </div>
  </div>
</section>

<style>
  .home-promise {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --ink: #1A1228;
    display: grid;
    position: relative;
    overflow: hidden;
  }

  .home-promise > :not(.ekilia-flora) {
    position: relative;
    z-index: 1;
  }

  .home-promise__cream,
  .home-promise__forest {
    padding: 7.6rem 1.5rem 2.6rem;
  }

  .home-promise__cream {
    background: var(--cream);
    color: var(--ink);
  }

  .home-promise h2 {
    font-family: Fraunces, serif;
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-promise__cream > p:last-of-type,
  .home-promise__act > p {
    margin: 0;
    max-width: 32rem;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .home-promise__cream > p:last-of-type {
    margin-top: 1.1rem;
  }

  .home-promise__forest {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
    display: grid;
    align-content: space-between;
    gap: 1.8rem;
    overflow: hidden;
  }

  .home-promise__forest > :not(.ekilia-flora) {
    position: relative;
    z-index: 1;
  }

  .home-promise__forest h3 {
    font-family: Fraunces, serif;
    margin: 0;
    max-width: 10ch;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-promise__claim {
    font-family: Fraunces, serif;
    margin: 1rem 0 0;
    max-width: 16ch;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 500;
    line-height: 1.2;
  }

  @media (min-width: 900px) {
    .home-promise {
      grid-template-columns: 1fr 1fr;
    }

    .home-promise__cream,
    .home-promise__forest {
      min-height: 28rem;
      padding: 8.4rem 2.6rem;
    }
  }
</style>

