---
import GlyvFlora from '@components/home/GlyvFlora.astro';
import GlyvNerves from '@components/home/GlyvNerves.astro';
import GlyvButtons from '@components/ui/GlyvButtons.astro';
import { PRODUCTS } from '@utils/constants';

const photos = {
  centia: {
    src: '/centia.jpg',
    alt: 'Frasco Glyv Centia con nopal, canela y cápsulas',
  },
  nervia: {
    src: '/nervia.jpg',
    alt: 'Frasco Glyv Nervia con pasiflora y cápsulas',
  },
} as const;
---

<section class="home-products" aria-label="Productos Glyv">
  {
    PRODUCTS.map((product) => (
      <article class={`product-plate is-${product.tone}`} id={product.id} data-slide-host>
        <div class="product-plate__figure" data-slide={product.tone === 'nervia' ? 'right' : 'left'}>
          <img
            class="product-plate__photo"
            src={photos[product.tone].src}
            alt={photos[product.tone].alt}
            width="2000"
            height="2000"
          />
        </div>

        <div class="product-plate__copy" data-slide={product.tone === 'nervia' ? 'left' : 'right'}>
          {product.tone === 'nervia' && <GlyvNerves />}
          <h2>{product.name}</h2>
          <p class="product-plate__claim" set:html={product.claim.replace('. ', '.<br />')} />
          <p class="product-plate__use">
            {product.use} {product.pack}
          </p>
          <p class="product-plate__ings">{product.ingredients}</p>
          <GlyvButtons
            primary={product.cta}
            secondary={product.formula}
            primaryHref={`/${product.slug}`}
            secondaryHref={`/${product.slug}#ingredientes`}
          />
        </div>

        {product.tone === 'centia' && <GlyvFlora variant="plate" />}
      </article>
    ))
  }
</section>

<style>
  .home-products {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --petroleum: #0b4f6c;
    --ink: #1a2a22;
    font-family: Outfit, sans-serif;
  }

  .product-plate {
    position: relative;
    display: grid;
    min-height: 28rem;
    overflow: hidden;
  }

  .product-plate.is-centia {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .product-plate.is-nervia {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .product-plate__figure {
    position: relative;
    z-index: 1;
    min-height: 24rem;
    overflow: hidden;
    background: var(--cream);
  }

  .product-plate.is-nervia .product-plate__figure {
    background: #d7eaf3;
  }

  .product-plate__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .product-plate__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.5rem 2.2rem;
  }

  .product-plate__copy > :not(.glyv-nerves) {
    position: relative;
    z-index: 1;
  }

  .product-plate h2 {
    margin: 0;
    font-family: Fraunces, serif;
    font-size: clamp(2.6rem, 8vw, 5.2rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .product-plate__claim {
    margin: 1.15rem 0 0;
    max-width: 18ch;
    font-family: Fraunces, serif;
    font-size: clamp(1.25rem, 3vw, 1.85rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .product-plate__use {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    line-height: 1.45;
    opacity: 0.86;
  }

  .product-plate__ings {
    margin: 0.85rem 0 0;
    max-width: 34rem;
    font-size: 0.92rem;
    line-height: 1.5;
    opacity: 0.78;
  }

  @media (min-width: 900px) {
    .product-plate {
      grid-template-columns: 1fr 1fr;
      min-height: 36rem;
    }

    .product-plate.is-nervia .product-plate__figure {
      order: 1;
    }

    .product-plate__figure {
      min-height: 36rem;
    }

    .product-plate__copy {
      padding: 3rem 2.6rem;
    }
  }
</style>

