---
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.formula;
---

<section class="home-formula" aria-labelledby="home-formula-title">
  <div class="home-formula__copy">
    <h2 id="home-formula-title">{copy.h2}</h2>
    <p>{copy.body}</p>
  </div>
  <dl>
    {
      copy.marks.map((mark) => (
        <div>
          <dt>{mark.k}</dt>
          <dd>{mark.v}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .home-formula {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --ink: #1a2a22;
    background: var(--cream);
    color: var(--ink);
    padding: 3.2rem 1.5rem 2.8rem;
    font-family: Outfit, sans-serif;
  }

  .home-formula h2 {
    margin: 0;
    max-width: 16ch;
    font-family: Fraunces, serif;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-formula__copy p {
    margin: 1rem 0 0;
    max-width: 32rem;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .home-formula dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem 1.4rem;
    margin: 2rem 0 0;
  }

  .home-formula dt {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--forest);
  }

  .home-formula dd {
    margin: 0.25rem 0 0;
    font-family: Fraunces, serif;
    font-size: 1.2rem;
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .home-formula {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding: 3.6rem 2.6rem;
    }

    .home-formula dl {
      margin-top: 0.4rem;
      grid-template-columns: 1fr 1fr;
      align-content: center;
    }
  }
</style>
