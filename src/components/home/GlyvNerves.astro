---
const trunks = [
  'M800 150 C700 178 640 240 580 300',
  'M800 790 C710 760 650 710 590 640',
];

const branches = [
  'M580 300 C530 270 560 210 510 180',
  'M580 300 C540 350 590 390 540 430',
  'M590 640 C540 600 570 550 520 520',
];

const twigs = [
  'M510 180 C470 150 500 110 460 80',
  'M540 430 C500 460 530 500 490 530',
  'M520 520 C480 490 450 530 410 510',
];
---

<div class="glyv-nerves is-scroll" aria-hidden="true">
  <svg viewBox="0 0 800 900" fill="none" preserveAspectRatio="none">
    <g class="glyv-nerves__net">
      {trunks.map((d) => <path class="is-trunk" pathLength="1" d={d} />)}
      {branches.map((d) => <path class="is-branch" pathLength="1" d={d} />)}
      {twigs.map((d) => <path class="is-twig" pathLength="1" d={d} />)}
    </g>
  </svg>
</div>

<style>
  .glyv-nerves {
    --cream: #f4efe6;
    pointer-events: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: auto;
    width: 34%;
    z-index: 0;
    color: var(--on-dark, var(--cream));
  }

  .glyv-nerves svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .glyv-nerves__net {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: 0.55;
  }

  .glyv-nerves__net .is-trunk {
    stroke-width: 2.15;
  }

  .glyv-nerves__net .is-branch {
    stroke-width: 1.35;
  }

  .glyv-nerves__net .is-twig {
    stroke-width: 0.85;
    opacity: 0.75;
  }

  .glyv-nerves__net path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .glyv-nerves.is-auto .glyv-nerves__net path {
    animation: glyv-nerves-draw 3.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .glyv-nerves.is-auto .glyv-nerves__net .is-branch {
    animation-delay: 0.55s;
  }

  .glyv-nerves.is-auto .glyv-nerves__net .is-twig {
    animation-delay: 0.95s;
  }

  @keyframes glyv-nerves-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyv-nerves__net path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll('.glyv-nerves.is-scroll').forEach((nerves) => {
    if (reduceMotion) {
      nerves.classList.add('is-auto');
      return;
    }

    if (nerves.closest('[data-slide-host]')) return;

    ScrollTrigger.create({
      trigger: nerves.parentElement ?? nerves,
      start: 'top 82%',
      once: true,
      onEnter: () => nerves.classList.add('is-auto'),
    });
  });
</script>
