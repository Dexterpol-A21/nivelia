---
import { PALETTES } from '@utils/palettes';
---

<nav class="paleta-switch" aria-label="Paletas">
  {
    PALETTES.map((item) => (
      <a href={`/?paleta=${item.id}`}>
        <span class="paleta-switch__chips" aria-hidden="true">
          <i style={`background: ${item.cream}`} />
          <i style={`background: ${item.forest}`} />
          <i style={`background: ${item.petroleum}`} />
        </span>
        {item.name}
      </a>
    ))
  }
</nav>

<script is:inline define:vars={{ ids: PALETTES.map((item) => item.id) }}>
  const chosen = new URLSearchParams(location.search).get('paleta');
  const active = ids.includes(chosen) ? chosen : 'campos';
  document.querySelectorAll('.paleta-switch a').forEach((link) => {
    const on = link.getAttribute('href') === `/?paleta=${active}`;
    if (on) link.setAttribute('aria-current', 'true');
    else link.removeAttribute('aria-current');
  });
</script>

<style>
  .paleta-switch {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 70;
    display: flex;
    background: #1a2a22;
    color: #f4efe6;
    font-family: Outfit, sans-serif;
  }

  .paleta-switch a {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 0.35rem;
    border-right: 1.5px solid color-mix(in srgb, #f4efe6 28%, transparent);
    color: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .paleta-switch a:last-child {
    border-right: 0;
  }

  .paleta-switch a[aria-current='true'] {
    background: #f4efe6;
    color: #1a2a22;
  }

  .paleta-switch a:focus-visible {
    outline: 2px solid #f4efe6;
    outline-offset: -3px;
  }

  .paleta-switch__chips {
    display: flex;
    width: 1.7rem;
    height: 0.7rem;
    flex: none;
  }

  .paleta-switch__chips i {
    flex: 1;
    display: block;
  }

  .paleta-switch a[aria-current='true'] .paleta-switch__chips i:first-child {
    box-shadow: inset 0 0 0 1px #1a2a22;
  }

  :global(body:has(.paleta-switch)) {
    padding-bottom: 2.75rem;
  }

  @media (max-width: 899px) {
    .paleta-switch {
      flex-wrap: wrap;
    }

    .paleta-switch a {
      flex: 1 1 25%;
      flex-direction: column;
      gap: 0.2rem;
      min-height: 3.15rem;
      font-size: 0.72rem;
    }

    .paleta-switch a:nth-child(4n) {
      border-right: 0;
    }

    :global(body:has(.paleta-switch)) {
      padding-bottom: 6.3rem;
    }
  }
</style>
