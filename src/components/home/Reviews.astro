---
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.reviews;
---

<section class="home-reviews" id="resenas" aria-labelledby="home-reviews-title">
  <h2 id="home-reviews-title">{copy.h2}</h2>
  <ul>
    {
      copy.items.map((item) => (
        <li>
          <blockquote>
            <p>{item.quote}</p>
            <footer>
              <cite>{item.name}</cite>
              <span>{item.place}</span>
            </footer>
          </blockquote>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .home-reviews {
    --cream: #f4efe6;
    --forest: #1e4a32;
    background: var(--forest);
    color: var(--cream);
    padding: 3.2rem 1.5rem 2.8rem;
    font-family: Outfit, sans-serif;
  }

  .home-reviews h2 {
    margin: 0 0 1.8rem;
    font-family: Fraunces, serif;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-reviews ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-reviews li {
    padding: 1.4rem 0;
    border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .home-reviews blockquote {
    margin: 0;
  }

  .home-reviews blockquote p {
    margin: 0;
    max-width: 22ch;
    font-family: Fraunces, serif;
    font-size: clamp(1.35rem, 3.2vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .home-reviews footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    margin-top: 0.9rem;
    font-size: 0.92rem;
  }

  .home-reviews cite {
    font-style: normal;
    font-weight: 600;
  }

  .home-reviews span {
    opacity: 0.72;
  }

  @media (min-width: 900px) {
    .home-reviews {
      padding: 3.6rem 2.6rem 3rem;
    }

    .home-reviews ul {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0 2rem;
    }

    .home-reviews li {
      padding: 0;
      border-top: 0;
      border-left: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
      padding-left: 1.6rem;
    }

    .home-reviews li:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
