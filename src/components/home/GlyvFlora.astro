    .glyv-flora.is-ink-light .glyv-flora__svg,
    .glyv-flora.is-ink-dark .glyv-flora__svg {
      width: 100%;
      left: 0;
    }

    .glyv-flora.is-main {
      height: var(--flora-main-h-desktop, var(--flora-main-h, max(10.5rem, 11.25vw)));
    }

    .glyv-flora.is-seam.is-edge-top,
    .glyv-flora.is-seam.is-edge-bottom {
      height: var(--flora-seam-h, 8rem);
    }

    .glyv-flora.is-bottom {
      display: grid;
      top: auto;
      left: 0;
      right: 0;
      bottom: var(--flora-bottom, 0);
      height: var(--flora-bottom-h, 10.5rem);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  type Branch = {
    d: string;
    count: number;
    length: number;
    start?: number;
    end?: number;
    side?: number;
  };

  const round = (n: number) => Math.round(n * 10) / 10;

  function parseCubics(d: string) {
    const nums = (d.match(/-?\d*\.?\d+/g) ?? []).map(Number);
    const segs: { p0: { x: number; y: number }; p1: { x: number; y: number }; p2: { x: number; y: number }; p3: { x: number; y: number } }[] = [];
    let i = 0;
    let x = nums[i++] ?? 0;
    let y = nums[i++] ?? 0;
    while (i + 5 < nums.length) {
      const p1 = { x: nums[i++], y: nums[i++] };
      const p2 = { x: nums[i++], y: nums[i++] };
      const p3 = { x: nums[i++], y: nums[i++] };
      segs.push({ p0: { x, y }, p1, p2, p3 });
      x = p3.x;
      y = p3.y;
    }
    return segs;
  }

  function cubicAt(
    seg: { p0: { x: number; y: number }; p1: { x: number; y: number }; p2: { x: number; y: number }; p3: { x: number; y: number } },
    t: number,
  ) {
    const u = 1 - t;
    return {
      x: u ** 3 * seg.p0.x + 3 * u ** 2 * t * seg.p1.x + 3 * u * t ** 2 * seg.p2.x + t ** 3 * seg.p3.x,
      y: u ** 3 * seg.p0.y + 3 * u ** 2 * t * seg.p1.y + 3 * u * t ** 2 * seg.p2.y + t ** 3 * seg.p3.y,
    };
  }

  function cubicDeriv(
    seg: { p0: { x: number; y: number }; p1: { x: number; y: number }; p2: { x: number; y: number }; p3: { x: number; y: number } },
    t: number,
  ) {
    const u = 1 - t;
    return {
      x: 3 * u ** 2 * (seg.p1.x - seg.p0.x) + 6 * u * t * (seg.p2.x - seg.p1.x) + 3 * t ** 2 * (seg.p3.x - seg.p2.x),
      y: 3 * u ** 2 * (seg.p1.y - seg.p0.y) + 6 * u * t * (seg.p2.y - seg.p1.y) + 3 * t ** 2 * (seg.p3.y - seg.p2.y),
    };
  }

  const LEAF_HALF = 0.2;

  function heroLeaf(
    attachX: number,
    attachY: number,
    dirX: number,
    dirY: number,
    kX: number,
    kY: number,
    screenLen: number,
  ) {
    const w = screenLen * LEAF_HALF;
    const map = (x: number, y: number) => {
      const sx = attachX * kX + dirX * y - dirY * x;
      const sy = attachY * kY + dirY * y + dirX * x;
      return `${round(sx / kX)} ${round(sy / kY)}`;
    };
    const at = (t: number, side: number) => map(w * side, screenLen * t);
    const shoot = [
      `M${at(0, 0)}`,
      `C${at(0.06, 0.22)} ${at(0.2, 1)} ${at(0.42, 1)}`,
      `C${at(0.62, 0.86)} ${at(0.8, 0.42)} ${at(0.9, 0.18)}`,
      `C${at(0.97, 0.07)} ${at(0.97, -0.07)} ${at(0.9, -0.18)}`,
      `C${at(0.8, -0.42)} ${at(0.62, -0.86)} ${at(0.42, -1)}`,
      `C${at(0.2, -1)} ${at(0.06, -0.22)} ${at(0, 0)}`,
    ].join(' ');
    const rib = `M${at(0.12, 0)} Q${at(0.48, 0)} ${at(0.84, 0)}`;
    return { shoot, rib };
  }

  function placeInView(
    x: number,
    y: number,
    fx: number,
    fy: number,
    nx: number,
    ny: number,
    prefer: number,
    length: number,
    kX: number,
    kY: number,
    vbW: number,
    vbH: number,
  ) {
    const half = 0.2;
    const probe = (side: number, len: number) => {
      let dirX = nx * side + fx * 0.18;
      let dirY = ny * side + fy * 0.18;
      const dlen = Math.hypot(dirX, dirY) || 1;
      dirX /= dlen;
      dirY /= dlen;
      const px = -dirY;
      const py = dirX;
      const wide = len * half;
      const marks = [
        [len, 0],
        [len * 0.42, wide],
        [len * 0.42, -wide],
        [len * 0.9, wide * 0.18],
        [len * 0.9, -wide * 0.18],
      ];
      let room = Infinity;
      for (const [along, across] of marks) {
        const vx = x + (dirX * along + px * across) / kX;
        const vy = y + (dirY * along + py * across) / kY;
        room = Math.min(room, vx, vy, vbW - vx, vbH - vy);
      }
      return { room, dirX, dirY, len };
    };

    let len = length;
    let best = probe(prefer, len);
    for (let n = 0; n < 5; n++) {
      const a = probe(prefer, len);
      const b = probe(-prefer, len);
      best = a.room >= b.room ? a : b;
      if (best.room >= 3) break;
      len *= 0.72;
    }
    return best;
  }

  function leavesForBranch(branch: Branch, kX: number, kY: number, vbW: number, vbH: number) {
    const segs = parseCubics(branch.d);
    const samples: { x: number; y: number; tx: number; ty: number; s: number }[] = [];
    let dist = 0;
    let prev: { x: number; y: number } | null = null;
    segs.forEach((seg, si) => {
      const steps = 48;
      for (let i = si === 0 ? 0 : 1; i <= steps; i++) {
        const t = i / steps;
        const p = cubicAt(seg, t);
        const dlt = cubicDeriv(seg, t);
        if (prev) dist += Math.hypot(p.x - prev.x, p.y - prev.y);
        samples.push({ x: p.x, y: p.y, tx: dlt.x, ty: dlt.y, s: dist });
        prev = p;
      }
    });

    const total = samples[samples.length - 1]?.s ?? 1;
    const start = branch.start ?? 0.14;
    const end = branch.end ?? 0.9;
    const sideStart = branch.side ?? 1;
    const tips: { shoot: string; rib: string }[] = [];

    for (let i = 0; i < branch.count; i++) {
      const target = (start + ((end - start) * (i + 0.5)) / branch.count) * total;
      const sample = samples.find((pt) => pt.s >= target) ?? samples[samples.length - 1];
      if (!sample) continue;
      const tanX = sample.tx * kX;
      const tanY = sample.ty * kY;
      const tlen = Math.hypot(tanX, tanY) || 1;
      const fx = tanX / tlen;
      const fy = tanY / tlen;
      const nx = -fy;
      const ny = fx;
      const prefer = (i % 2 === 0 ? 1 : -1) * sideStart;
      const screenLen = branch.length * Math.sqrt(kX * kY);
      const placed = placeInView(sample.x, sample.y, fx, fy, nx, ny, prefer, screenLen, kX, kY, vbW, vbH);
      tips.push(heroLeaf(sample.x, sample.y, placed.dirX, placed.dirY, kX, kY, placed.len));
    }

    return tips;
  }

  function layoutPlateLeaves(flora: HTMLElement) {
    const raw = flora.dataset.branches;
    const svg =
      [...flora.querySelectorAll('svg')].find((node) => node.clientWidth >= 32 && node.clientHeight >= 8) ??
      flora.querySelector('svg');
    if (!raw || !svg) return;

    const width = svg.clientWidth;
    const height = svg.clientHeight;
    if (width < 32 || height < 8) return;

    const parts = (svg.getAttribute('viewBox') || '0 0 1600 900').trim().split(/[\s,]+/).map(Number);
    const vbW = parts[2] || 1600;
    const vbH = parts[3] || 900;
    const kX = width / vbW;
    const kY = height / vbH;
    const branches = JSON.parse(raw) as Branch[];
    const leaves = branches.flatMap((branch) => leavesForBranch(branch, kX, kY, vbW, vbH));

    flora.querySelectorAll('.glyv-flora__svg').forEach((node) => {
      const shoots = node.querySelectorAll('.is-shoot');
      const ribs = node.querySelectorAll('.is-rib');
      leaves.forEach((leaf, i) => {
        shoots[i]?.setAttribute('d', leaf.shoot);
        ribs[i]?.setAttribute('d', leaf.rib);
      });
    });
  }

  document.querySelectorAll<HTMLElement>('.glyv-flora[data-branches]').forEach((flora) => {
    const layout = () => layoutPlateLeaves(flora);
    layout();
    new ResizeObserver(layout).observe(flora);
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.glyv-flora.is-scroll:not(.is-plate)').forEach((flora) => {
    if (reduceMotion) {
      flora.classList.add('is-auto');
      return;
    }

    if (flora.closest('[data-slide-host]')) return;

    ScrollTrigger.create({
      trigger: flora.parentElement ?? flora,
      start: 'top 82%',
      once: true,
      onEnter: () => flora.classList.add('is-auto'),
    });
  });
</script>
