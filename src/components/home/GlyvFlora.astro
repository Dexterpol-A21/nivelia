---
interface Props {
  auto?: boolean;
  variant?: 'hero' | 'plate';
}

const { auto = false, variant = 'hero' } = Astro.props;
const drawClass = auto ? 'is-auto' : 'is-scroll';

const r = (n: number) => Math.round(n * 10) / 10;

type Pt = { x: number; y: number };

function leaf(x0: number, y0: number, x1: number, y1: number) {
  const dx = x1 - x0;
  const dy = y1 - y0;
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  const nx = -uy;
  const ny = ux;
  const px = x0 + ux * Math.min(16, len * 0.28);
  const py = y0 + uy * Math.min(16, len * 0.28);
  const w = Math.min(20, len * 0.3);
  const shoot = [
    `M${r(x0)} ${r(y0)}`,
    `Q${r(x0 + ux * 8 + nx * 1.2)} ${r(y0 + uy * 8 + ny * 1.2)} ${r(px)} ${r(py)}`,
    `C${r(px + nx * w + ux * 10)} ${r(py + ny * w + uy * 10)}`,
    `${r(x1 + nx * w * 0.3)} ${r(y1 + ny * w * 0.3)}`,
    `${r(x1)} ${r(y1)}`,
    `C${r(x1 - nx * w * 0.3)} ${r(y1 - ny * w * 0.3)}`,
    `${r(px - nx * w + ux * 8)} ${r(py - ny * w + uy * 8)}`,
    `${r(px)} ${r(py)}`,
  ].join(' ');
  const rib = `M${r(px)} ${r(py)} Q${r(px + ux * (len * 0.4))} ${r(py + uy * (len * 0.4))} ${r(x1)} ${r(y1)}`;
  return { shoot, rib };
}

function parseCubics(d: string) {
  const nums = (d?.match(/-?\d*\.?\d+/g) ?? []).map(Number);
  const segs: { p0: Pt; p1: Pt; p2: Pt; p3: Pt }[] = [];
  let i = 0;
  let x = nums[i++] ?? 0;
  let y = nums[i++] ?? 0;
  while (i + 5 < nums.length) {
    const p1 = { x: nums[i++], y: nums[i++] };
    const p2 = { x: nums[i++], y: nums[i++] };
    const p3 = { x: nums[i++], y: nums[i++] };
    segs.push({ p0: { x, y }, p1, p2, p3 });
    x = p3.x;
    y = p3.y;
  }
  return segs;
}

function cubicAt(seg: { p0: Pt; p1: Pt; p2: Pt; p3: Pt }, t: number): Pt {
  const u = 1 - t;
  return {
    x: u ** 3 * seg.p0.x + 3 * u ** 2 * t * seg.p1.x + 3 * u * t ** 2 * seg.p2.x + t ** 3 * seg.p3.x,
    y: u ** 3 * seg.p0.y + 3 * u ** 2 * t * seg.p1.y + 3 * u * t ** 2 * seg.p2.y + t ** 3 * seg.p3.y,
  };
}

function cubicDeriv(seg: { p0: Pt; p1: Pt; p2: Pt; p3: Pt }, t: number): Pt {
  const u = 1 - t;
  return {
    x: 3 * u ** 2 * (seg.p1.x - seg.p0.x) + 6 * u * t * (seg.p2.x - seg.p1.x) + 3 * t ** 2 * (seg.p3.x - seg.p2.x),
    y: 3 * u ** 2 * (seg.p1.y - seg.p0.y) + 6 * u * t * (seg.p2.y - seg.p1.y) + 3 * t ** 2 * (seg.p3.y - seg.p2.y),
  };
}

function leavesOnStem(
  d: string,
  count: number,
  length: number,
  start = 0.14,
  end = 0.9,
  sideStart = 1,
) {
  const segs = parseCubics(d);
  const samples: { x: number; y: number; tx: number; ty: number; s: number }[] = [];
  let dist = 0;
  let prev: Pt | null = null;
  segs.forEach((seg, si) => {
    const steps = 48;
    for (let i = si === 0 ? 0 : 1; i <= steps; i++) {
      const t = i / steps;
      const p = cubicAt(seg, t);
      const dlt = cubicDeriv(seg, t);
      if (prev) dist += Math.hypot(p.x - prev.x, p.y - prev.y);
      samples.push({ x: p.x, y: p.y, tx: dlt.x, ty: dlt.y, s: dist });
      prev = p;
    }
  });

  const total = samples.at(-1)?.s ?? 1;
  const tips: [number, number, number, number][] = [];

  for (let i = 0; i < count; i++) {
    const target = (start + ((end - start) * (i + 0.5)) / count) * total;
    const sample = samples.find((pt) => pt.s >= target) ?? samples.at(-1);
    if (!sample) continue;
    const tlen = Math.hypot(sample.tx, sample.ty) || 1;
    const fx = sample.tx / tlen;
    const fy = sample.ty / tlen;
    const nx = -fy;
    const ny = fx;
    const side = (i % 2 === 0 ? 1 : -1) * sideStart;
    tips.push([
      sample.x,
      sample.y,
      sample.x + nx * side * length + fx * length * 0.22,
      sample.y + ny * side * length + fy * length * 0.22,
    ]);
  }

  return tips;
}

function bundle(
  branches: { d: string; count: number; length: number; start?: number; end?: number; side?: number }[],
) {
  const stems = branches.map((branch) => branch.d);
  const tips = branches.flatMap((branch) =>
    leavesOnStem(branch.d, branch.count, branch.length, branch.start, branch.end, branch.side),
  );
  const leaves = tips.map(([a, b, c, d]) => leaf(a, b, c, d));
  return {
    stems,
    shoots: leaves.map((item) => item.shoot),
    ribs: leaves.map((item) => item.rib),
  };
}

