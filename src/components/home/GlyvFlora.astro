const vinePlate = bundle(plateBranches);

const layers =
  variant === 'plate'
    ? [{ class: 'is-plate', vine: vinePlate, viewBox: '0 0 1600 900' }]
    : [
        { class: 'is-main', vine: vineMain, viewBox: '0 0 1600 180' },
        { class: 'is-bottom', vine: vineBottom, viewBox: '0 0 1600 200' },
      ];
---

{
  layers.map((layer) => (
    <div
      class={`glyv-flora ${layer.class} ${drawClass}`}
      aria-hidden="true"
      data-branches={layer.class === 'is-plate' ? JSON.stringify(plateBranches) : undefined}
    >
      {['is-dark', 'is-light'].map((tone) => (
        <div class={`glyv-flora__clip ${tone}`}>
          <svg
            class={`glyv-flora__svg ${tone}`}
            viewBox={layer.viewBox}
            fill="none"
            preserveAspectRatio="none"
          >
            <g class="glyv-flora__vine">
              {layer.vine.stems.map((d) => (
                <path class="is-stem" pathLength="1" d={d} />
              ))}
              {layer.vine.shoots.map((d) => (
                <path class="is-shoot" pathLength="1" d={d} />
              ))}
              {layer.vine.ribs.map((d) => (
                <path class="is-rib" pathLength="1" d={d} />
              ))}
            </g>
          </svg>
        </div>
      ))}
    </div>
  ))
}

<style>
  .glyv-flora {
    --cream: #f4efe6;
    --forest: #1e4a32;
    pointer-events: none;
    position: absolute;
    z-index: 4;
  }

  .glyv-flora.is-main {
    top: 0;
    left: 0;
    right: 0;
    height: var(--flora-main-h, max(7.5rem, 11.25vw));
    overflow: visible;
  }

  .glyv-flora.is-plate {
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .glyv-flora.is-plate .glyv-flora__clip {
    height: 100%;
  }

  .glyv-flora.is-bottom {
    display: none;
  }

  .glyv-flora__clip {
    position: relative;
    overflow: hidden;
    min-width: 0;
  }

  .glyv-flora__svg {
    position: absolute;
    top: 0;
    height: 100%;
    width: 100%;
  }

  .glyv-flora__svg.is-dark {
    color: var(--forest);
  }

  .glyv-flora__clip.is-light {
    display: none;
  }

  .glyv-flora__svg.is-light {
    color: var(--cream);
  }

  .glyv-flora__vine {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: 0.82;
  }

  .glyv-flora__vine .is-stem {
    stroke-width: 2.05;
  }

  .glyv-flora__vine .is-shoot {
    stroke-width: 1.45;
  }

  .glyv-flora__vine .is-rib {
    stroke-width: 0.8;
    opacity: 0.7;
  }

  .glyv-flora__vine path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .glyv-flora.is-auto .glyv-flora__vine path {
    animation: glyv-flora-vine 3.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .glyv-flora.is-auto .glyv-flora__vine .is-shoot {
    animation-delay: 0.55s;
  }

  .glyv-flora.is-auto .glyv-flora__vine .is-rib {
    animation-delay: 0.95s;
  }

  @keyframes glyv-flora-vine {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyv-flora__vine path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (min-width: 900px) {
    .glyv-flora.is-main,
    .glyv-flora.is-bottom,
    .glyv-flora.is-plate {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .glyv-flora__clip.is-light {
      display: block;
    }

    .glyv-flora__svg {
      width: 200%;
    }

    .glyv-flora__clip.is-dark .glyv-flora__svg {
      left: 0;
    }

    .glyv-flora__clip.is-light .glyv-flora__svg {
      left: -100%;
    }

    .glyv-flora.is-main {
      height: var(--flora-main-h-desktop, var(--flora-main-h, max(10.5rem, 11.25vw)));
    }

    .glyv-flora.is-bottom {
      display: grid;
      top: auto;
      left: 0;
      right: 0;
      bottom: var(--flora-bottom, 0);
      height: var(--flora-bottom-h, 10.5rem);
    }
  }
</style>

<script>
  type Branch = {
    d: string;
    count: number;
    length: number;
    start?: number;
    end?: number;
    side?: number;
  };

  const VB_W = 1600;
  const VB_H = 900;

  const round = (n: number) => Math.round(n * 10) / 10;

  function parseCubics(d: string) {
    const nums = (d.match(/-?\d*\.?\d+/g) ?? []).map(Number);
    const segs: { p0: { x: number; y: number }; p1: { x: number; y: number }; p2: { x: number; y: number }; p3: { x: number; y: number } }[] = [];
    let i = 0;
    let x = nums[i++] ?? 0;
    let y = nums[i++] ?? 0;
    while (i + 5 < nums.length) {
      const p1 = { x: nums[i++], y: nums[i++] };
      const p2 = { x: nums[i++], y: nums[i++] };
      const p3 = { x: nums[i++], y: nums[i++] };
      segs.push({ p0: { x, y }, p1, p2, p3 });
      x = p3.x;
      y = p3.y;
    }
    return segs;
  }

  function cubicAt(
    seg: { p0: { x: number; y: number }; p1: { x: number; y: number }; p2: { x: number; y: number }; p3: { x: number; y: number } },
    t: number,
  ) {
    const u = 1 - t;
    return {
      x: u ** 3 * seg.p0.x + 3 * u ** 2 * t * seg.p1.x + 3 * u * t ** 2 * seg.p2.x + t ** 3 * seg.p3.x,
      y: u ** 3 * seg.p0.y + 3 * u ** 2 * t * seg.p1.y + 3 * u * t ** 2 * seg.p2.y + t ** 3 * seg.p3.y,
    };
  }

  function cubicDeriv(
    seg: { p0: { x: number; y: number }; p1: { x: number; y: number }; p2: { x: number; y: number }; p3: { x: number; y: number } },
    t: number,
  ) {
    const u = 1 - t;
    return {
      x: 3 * u ** 2 * (seg.p1.x - seg.p0.x) + 6 * u * t * (seg.p2.x - seg.p1.x) + 3 * t ** 2 * (seg.p3.x - seg.p2.x),
      y: 3 * u ** 2 * (seg.p1.y - seg.p0.y) + 6 * u * t * (seg.p2.y - seg.p1.y) + 3 * t ** 2 * (seg.p3.y - seg.p2.y),
    };
  }

  const HERO_LEAF = {
    tipX: 19.2,
    tipY: 41.8,
    shoot: [
      [0, 0],
      [-0.4, 9.2, 6.9, 15.1],
      [1, 33.3, 16.8, 42.5, 19.2, 41.8],
      [21.5, 41.2, 24.6, 22.5, 6.9, 15.1],
    ],
    rib: [6.9, 15.1, 11.6, 28.5, 19.2, 41.8],
  } as const;

  const HERO_AXIS = Math.hypot(HERO_LEAF.tipX, HERO_LEAF.tipY);
  const AXIS_COS = HERO_LEAF.tipY / HERO_AXIS;
  const AXIS_SIN = HERO_LEAF.tipX / HERO_AXIS;
  const HERO_PX = 36;

  function toLeafAxis(x: number, y: number) {
    return {
      x: x * AXIS_COS - y * AXIS_SIN,
      y: x * AXIS_SIN + y * AXIS_COS,
    };
  }

  function heroLeaf(
    attachX: number,
    attachY: number,
    dirX: number,
    dirY: number,
    kX: number,
    kY: number,
    flip: boolean,
  ) {
    const scale = HERO_PX / HERO_AXIS;
    const side = flip ? -1 : 1;
    const map = (x: number, y: number) => {
      const local = toLeafAxis(x, y);
      const px = local.x * side * scale;
      const py = local.y * scale;
      const sx = attachX * kX + dirX * py + -dirY * px;
      const sy = attachY * kY + dirY * py + dirX * px;
      return `${round(sx / kX)} ${round(sy / kY)}`;
    };

    const shoot = [
      `M${map(0, 0)}`,
      `Q${map(HERO_LEAF.shoot[1][0], HERO_LEAF.shoot[1][1])} ${map(HERO_LEAF.shoot[1][2], HERO_LEAF.shoot[1][3])}`,
      `C${map(HERO_LEAF.shoot[2][0], HERO_LEAF.shoot[2][1])} ${map(HERO_LEAF.shoot[2][2], HERO_LEAF.shoot[2][3])} ${map(HERO_LEAF.shoot[2][4], HERO_LEAF.shoot[2][5])}`,
      `C${map(HERO_LEAF.shoot[3][0], HERO_LEAF.shoot[3][1])} ${map(HERO_LEAF.shoot[3][2], HERO_LEAF.shoot[3][3])} ${map(HERO_LEAF.shoot[3][4], HERO_LEAF.shoot[3][5])}`,
    ].join(' ');

    const rib = `M${map(HERO_LEAF.rib[0], HERO_LEAF.rib[1])} Q${map(HERO_LEAF.rib[2], HERO_LEAF.rib[3])} ${map(HERO_LEAF.rib[4], HERO_LEAF.rib[5])}`;
    return { shoot, rib };
  }

  function leavesForBranch(branch: Branch, kX: number, kY: number) {
    const segs = parseCubics(branch.d);
    const samples: { x: number; y: number; tx: number; ty: number; s: number }[] = [];
    let dist = 0;
    let prev: { x: number; y: number } | null = null;
    segs.forEach((seg, si) => {
      const steps = 48;
      for (let i = si === 0 ? 0 : 1; i <= steps; i++) {
        const t = i / steps;
        const p = cubicAt(seg, t);
        const dlt = cubicDeriv(seg, t);
        if (prev) dist += Math.hypot(p.x - prev.x, p.y - prev.y);
        samples.push({ x: p.x, y: p.y, tx: dlt.x, ty: dlt.y, s: dist });
        prev = p;
      }
    });

    const total = samples[samples.length - 1]?.s ?? 1;
    const start = branch.start ?? 0.14;
    const end = branch.end ?? 0.9;
    const sideStart = branch.side ?? 1;
    const tips: { shoot: string; rib: string }[] = [];

    for (let i = 0; i < branch.count; i++) {
      const target = (start + ((end - start) * (i + 0.5)) / branch.count) * total;
      const sample = samples.find((pt) => pt.s >= target) ?? samples[samples.length - 1];
      if (!sample) continue;
      const tanX = sample.tx * kX;
      const tanY = sample.ty * kY;
      const tlen = Math.hypot(tanX, tanY) || 1;
      const fx = tanX / tlen;
      const fy = tanY / tlen;
      const nx = -fy;
      const ny = fx;
      const side = (i % 2 === 0 ? 1 : -1) * sideStart;
      const dirX = nx * side * 0.92 + fx * 0.39;
      const dirY = ny * side + fy * 0.39;
      const dlen = Math.hypot(dirX, dirY) || 1;
      tips.push(
        heroLeaf(sample.x, sample.y, dirX / dlen, dirY / dlen, kX, kY, side < 0),
      );
    }

    return tips;
  }

  function layoutPlateLeaves() {
    const flora = document.querySelector<HTMLElement>('.glyv-flora.is-plate');
    const raw = flora?.dataset.branches;
    const svg = flora?.querySelector('svg');
    if (!flora || !raw || !svg) return;

    const rect = svg.getBoundingClientRect();
    if (rect.width < 32 || rect.height < 32) return;

    const kX = rect.width / VB_W;
    const kY = rect.height / VB_H;
    const branches = JSON.parse(raw) as Branch[];
    const leaves = branches.flatMap((branch) => leavesForBranch(branch, kX, kY));

    flora.querySelectorAll('.glyv-flora__svg').forEach((node) => {
      const shoots = node.querySelectorAll('.is-shoot');
      const ribs = node.querySelectorAll('.is-rib');
      leaves.forEach((leaf, i) => {
        shoots[i]?.setAttribute('d', leaf.shoot);
        ribs[i]?.setAttribute('d', leaf.rib);
      });
    });
  }

  const flora = document.querySelector('.glyv-flora.is-plate');
  if (flora) {
    layoutPlateLeaves();
    new ResizeObserver(layoutPlateLeaves).observe(flora);
  }
</script>
