---
interface Props {
  auto?: boolean;
  variant?: 'hero' | 'plate' | 'seam' | 'leaves';
  ink?: 'split' | 'light' | 'dark';
  edge?: 'top' | 'bottom';
}

const { auto = false, variant = 'hero', ink = 'split', edge = 'top' } = Astro.props;
const drawClass = auto ? 'is-auto' : 'is-scroll';

const r = (n: number) => Math.round(n * 10) / 10;

type Pt = { x: number; y: number };

function leaf(x0: number, y0: number, x1: number, y1: number, _breadth = 1) {
  const dx = x1 - x0;
  const dy = y1 - y0;
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  const nx = -uy;
  const ny = ux;
  const w = len * 0.2;
  const at = (t: number, side: number) =>
    `${r(x0 + ux * len * t + nx * w * side)} ${r(y0 + uy * len * t + ny * w * side)}`;
  const shoot = [
    `M${at(0, 0)}`,
    `C${at(0.06, 0.22)} ${at(0.2, 1)} ${at(0.42, 1)}`,
    `C${at(0.62, 0.86)} ${at(0.8, 0.42)} ${at(0.9, 0.18)}`,
    `C${at(0.97, 0.07)} ${at(0.97, -0.07)} ${at(0.9, -0.18)}`,
    `C${at(0.8, -0.42)} ${at(0.62, -0.86)} ${at(0.42, -1)}`,
    `C${at(0.2, -1)} ${at(0.06, -0.22)} ${at(0, 0)}`,
  ].join(' ');
  const rib = `M${at(0.12, 0)} Q${at(0.48, 0)} ${at(0.84, 0)}`;
  return { shoot, rib };
}

function parseCubics(d: string) {
  const nums = (d?.match(/-?\d*\.?\d+/g) ?? []).map(Number);
  const segs: { p0: Pt; p1: Pt; p2: Pt; p3: Pt }[] = [];
  let i = 0;
  let x = nums[i++] ?? 0;
  let y = nums[i++] ?? 0;
  while (i + 5 < nums.length) {
    const p1 = { x: nums[i++], y: nums[i++] };
    const p2 = { x: nums[i++], y: nums[i++] };
    const p3 = { x: nums[i++], y: nums[i++] };
    segs.push({ p0: { x, y }, p1, p2, p3 });
    x = p3.x;
    y = p3.y;
  }
  return segs;
}

function cubicAt(seg: { p0: Pt; p1: Pt; p2: Pt; p3: Pt }, t: number): Pt {
  const u = 1 - t;
  return {
    x: u ** 3 * seg.p0.x + 3 * u ** 2 * t * seg.p1.x + 3 * u * t ** 2 * seg.p2.x + t ** 3 * seg.p3.x,
    y: u ** 3 * seg.p0.y + 3 * u ** 2 * t * seg.p1.y + 3 * u * t ** 2 * seg.p2.y + t ** 3 * seg.p3.y,
  };
}

function cubicDeriv(seg: { p0: Pt; p1: Pt; p2: Pt; p3: Pt }, t: number): Pt {
  const u = 1 - t;
  return {
    x: 3 * u ** 2 * (seg.p1.x - seg.p0.x) + 6 * u * t * (seg.p2.x - seg.p1.x) + 3 * t ** 2 * (seg.p3.x - seg.p2.x),
    y: 3 * u ** 2 * (seg.p1.y - seg.p0.y) + 6 * u * t * (seg.p2.y - seg.p1.y) + 3 * t ** 2 * (seg.p3.y - seg.p2.y),
  };
}

function leavesOnStem(
  d: string,
  count: number,
  length: number,
  start = 0.14,
  end = 0.9,
  sideStart = 1,
  vbW = 1600,
  vbH = 900,
) {
  const segs = parseCubics(d);
  const samples: { x: number; y: number; tx: number; ty: number; s: number }[] = [];
  let dist = 0;
  let prev: Pt | null = null;
  segs.forEach((seg, si) => {
    const steps = 48;
    for (let i = si === 0 ? 0 : 1; i <= steps; i++) {
      const t = i / steps;
      const p = cubicAt(seg, t);
      const dlt = cubicDeriv(seg, t);
      if (prev) dist += Math.hypot(p.x - prev.x, p.y - prev.y);
      samples.push({ x: p.x, y: p.y, tx: dlt.x, ty: dlt.y, s: dist });
      prev = p;
    }
  });

  const total = samples.at(-1)?.s ?? 1;
  const tips: [number, number, number, number][] = [];

  for (let i = 0; i < count; i++) {
    const target = (start + ((end - start) * (i + 0.5)) / count) * total;
    const sample = samples.find((pt) => pt.s >= target) ?? samples.at(-1);
    if (!sample) continue;
    const tlen = Math.hypot(sample.tx, sample.ty) || 1;
    const fx = sample.tx / tlen;
    const fy = sample.ty / tlen;
    const nx = -fy;
    const ny = fx;
    const prefer = (i % 2 === 0 ? 1 : -1) * sideStart;
    const placed = placeLeaf(sample.x, sample.y, fx, fy, nx, ny, prefer, length, 1, 1, vbW, vbH);
    tips.push([sample.x, sample.y, placed.tipX, placed.tipY]);
  }

  return tips;
}

function placeLeaf(
  x: number,
  y: number,
  fx: number,
  fy: number,
  nx: number,
  ny: number,
  prefer: number,
  length: number,
  kX: number,
  kY: number,
  vbW: number,
  vbH: number,
) {
  const half = 0.2;
  const probe = (side: number, len: number) => {
    let dirX = nx * side + fx * 0.18;
    let dirY = ny * side + fy * 0.18;
    const dlen = Math.hypot(dirX, dirY) || 1;
    dirX /= dlen;
    dirY /= dlen;
    const px = -dirY;
    const py = dirX;
    const wide = len * half;
    const marks = [
      [len, 0],
      [len * 0.42, wide],
      [len * 0.42, -wide],
      [len * 0.9, wide * 0.18],
      [len * 0.9, -wide * 0.18],
    ];
    let room = Infinity;
    for (const [along, across] of marks) {
      const vx = x + (dirX * along + px * across) / kX;
      const vy = y + (dirY * along + py * across) / kY;
      room = Math.min(room, vx, vy, vbW - vx, vbH - vy);
    }
    return { room, dirX, dirY, len };
  };

  let len = length;
  let best = probe(prefer, len);
  for (let n = 0; n < 5; n++) {
    const a = probe(prefer, len);
    const b = probe(-prefer, len);
    best = a.room >= b.room ? a : b;
    if (best.room >= 3) break;
    len *= 0.72;
  }

  return {
    dirX: best.dirX,
    dirY: best.dirY,
    len: best.len,
    tipX: x + (best.dirX * best.len) / kX,
    tipY: y + (best.dirY * best.len) / kY,
  };
}

function bundle(
  branches: {
    d: string;
    count: number;
    length: number;
    start?: number;
    end?: number;
    side?: number;
    breadth?: number;
  }[],
  box = { w: 1600, h: 900 },
) {
  const stems = branches.map((branch) => branch.d);
  const leaves = branches.flatMap((branch) =>
    leavesOnStem(
      branch.d,
      branch.count,
      branch.length,
      branch.start,
      branch.end,
      branch.side,
      box.w,
      box.h,
    ).map(([a, b, c, d]) => leaf(a, b, c, d, branch.breadth ?? 1)),
  );
  return {
    stems,
    shoots: leaves.map((item) => item.shoot),
    ribs: leaves.map((item) => item.rib),
  };
}

const seamTopBranches = [
  {
    d: 'M0 10 C44.9 17.7 120.3 28.5 210 46 C299.7 63.5 328.1 91.1 420 92 C511.9 92.9 541.7 44.4 640 50 C738.3 55.6 773.2 113.3 880 118 C986.8 122.7 1028.9 63.5 1140 72 C1251.1 80.5 1293.2 136.6 1400 158 C1506.8 179.4 1588.7 169 1640 172',
    count: 7,
    length: 46,
    start: 0.08,
    end: 0.92,
  },
];

const seamBottomBranches = [
  {
    d: 'M0 188 C32.1 175.2 85.9 153.6 150 128 C214.1 102.4 231.6 86.4 300 68 C368.4 49.6 397.4 41.1 470 42 C542.6 42.9 569.5 53.6 640 72 C710.5 90.4 731.6 107.5 800 128 C868.4 148.5 887.4 157.3 960 168 C1032.6 178.7 1063.1 182.3 1140 178 C1216.9 173.7 1247.4 151.4 1320 148 C1392.6 144.6 1411.6 152.6 1480 162 C1548.4 171.4 1605.8 185.6 1640 192',
    count: 10,
    length: 46,
    start: 0.06,
    end: 0.94,
  },
];

const vineMain = bundle(seamTopBranches, { w: 1600, h: 180 });
const vineBottom = bundle(seamBottomBranches, { w: 1600, h: 200 });

const plateBranches = [
  {
    d: 'M0 860 C48 770 66 640 80 510 C94 380 128 250 186 198 C228 148 268 138 300 192',
    count: 6,
    length: 48,
    start: 0.1,
    end: 0.92,
  },
  {
    d: 'M8 12 C78 30 150 22 198 68 C228 92 218 128 176 118',
    count: 3,
    length: 40,
    start: 0.16,
    end: 0.86,
    side: -1,
  },
  {
    d: 'M800 14 C776 78 816 150 798 248',
    count: 3,
    length: 42,
    start: 0.16,
    end: 0.88,
  },
  {
    d: 'M1600 8 C1524 34 1448 82 1396 138 C1366 168 1408 198 1464 208',
    count: 3,
    length: 40,
    start: 0.14,
    end: 0.86,
  },
  {
    d: 'M800 900 C778 850 808 798 770 728',
    count: 3,
    length: 42,
    start: 0.16,
    end: 0.88,
    side: -1,
  },
];

const vinePlate = bundle(plateBranches);

const leafSprigs = [
  {
    d: 'M1720 -40 C1640 90 1580 240 1600 400 C1620 560 1680 720 1740 900',
    count: 5,
    length: 70,
    start: 0.08,
    end: 0.9,
  },
  {
    d: 'M1560 -10 C1520 150 1500 320 1540 500 C1580 680 1640 840 1700 1020',
    count: 4,
    length: 64,
    start: 0.1,
    end: 0.88,
    side: -1,
  },
];

const vineLeaves = bundle(leafSprigs);

const layers =
  variant === 'plate'
    ? [{ class: 'is-plate', vine: vinePlate, viewBox: '0 0 1600 900', ratio: 'none', branches: plateBranches }]
    : variant === 'leaves'
      ? [{ class: 'is-leaves is-ink-light', vine: vineLeaves, viewBox: '0 0 1600 900', ratio: 'none', branches: leafSprigs }]
      : variant === 'seam'
      ? [
          {
            class: `is-seam is-edge-${edge} is-ink-${ink}`,
            vine: edge === 'bottom' ? vineBottom : vineMain,
            viewBox: edge === 'bottom' ? '0 0 1600 200' : '0 0 1600 180',
            ratio: 'none',
            branches: edge === 'bottom' ? seamBottomBranches : seamTopBranches,
          },
        ]
      : [
          { class: 'is-main', vine: vineMain, viewBox: '0 0 1600 180', ratio: 'none', branches: seamTopBranches },
          { class: 'is-bottom', vine: vineBottom, viewBox: '0 0 1600 200', ratio: 'none', branches: seamBottomBranches },
        ];
---

{
  layers.map((layer) => (
    <div
      class={`glyv-flora ${layer.class} ${drawClass}`}
      aria-hidden="true"
      data-branches={JSON.stringify(layer.branches)}
    >
      {['is-dark', 'is-light'].map((tone) => (
        <div class={`glyv-flora__clip ${tone}`}>
          <svg
            class={`glyv-flora__svg ${tone}`}
            viewBox={layer.viewBox}
            fill="none"
            preserveAspectRatio={layer.ratio}
          >
            <g class="glyv-flora__vine">
              {layer.vine.stems.map((d) => (
                <path class="is-stem" pathLength="1" d={d} />
              ))}
              {layer.vine.shoots.map((d) => (
                <path class="is-shoot" pathLength="1" d={d} />
              ))}
              {layer.vine.ribs.map((d) => (
                <path class="is-rib" pathLength="1" d={d} />
              ))}
            </g>
          </svg>
        </div>
      ))}
    </div>
  ))
}

<style>
  .glyv-flora {
    --cream: #f4efe6;
    --forest: #1e4a32;
    pointer-events: none;
    position: absolute;
    z-index: 4;
  }

  .glyv-flora.is-main {
    top: 0;
    left: 0;
    right: 0;
    height: var(--flora-main-h, max(7.5rem, 11.25vw));
    overflow: visible;
  }

  .glyv-flora.is-plate {
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .glyv-flora.is-leaves {
    inset: 0;
    overflow: hidden;
    z-index: 0;
    display: grid;
  }

  .glyv-flora.is-leaves .glyv-flora__clip {
    height: 100%;
  }

  .glyv-flora.is-leaves .glyv-flora__vine .is-stem {
    stroke-width: 3.4;
  }

  .glyv-flora.is-leaves .glyv-flora__vine .is-shoot {
    stroke-width: 2.5;
  }

  .glyv-flora.is-leaves .glyv-flora__vine .is-rib {
    stroke-width: 1.35;
  }

  .glyv-flora.is-leaves .glyv-flora__vine .is-stem {
    stroke-width: 3.4;
  }

  .glyv-flora.is-leaves .glyv-flora__vine .is-shoot {
    stroke-width: 2.5;
  }

  .glyv-flora.is-leaves .glyv-flora__vine .is-rib {
    stroke-width: 1.4;
  }

  .glyv-flora.is-seam {
    display: grid;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: var(--flora-seam-h, 7.5rem);
    overflow: hidden;
    z-index: 0;
  }

  .glyv-flora.is-seam .glyv-flora__clip {
    min-height: 0;
    height: 100%;
  }

  .glyv-flora.is-seam.is-edge-bottom {
    top: auto;
    bottom: 0;
    height: var(--flora-seam-h, 8rem);
  }

  .glyv-flora.is-ink-light .glyv-flora__clip.is-dark,
  .glyv-flora.is-ink-dark .glyv-flora__clip.is-light {
    display: none;
  }

  .glyv-flora.is-ink-light .glyv-flora__clip.is-light,
  .glyv-flora.is-ink-dark .glyv-flora__clip.is-dark {
    display: block;
    height: 100%;
  }

  .glyv-flora.is-ink-light .glyv-flora__svg,
  .glyv-flora.is-ink-dark .glyv-flora__svg {
    width: 100%;
    left: 0;
  }

  .glyv-flora.is-plate .glyv-flora__clip {
    height: 100%;
  }

  .glyv-flora.is-bottom {
    display: none;
  }

  .glyv-flora__clip {
    position: relative;
    overflow: hidden;
    min-width: 0;
  }

  .glyv-flora__svg {
    position: absolute;
    top: 0;
    height: 100%;
    width: 100%;
  }

  .glyv-flora__svg.is-dark {
    color: var(--forest);
  }

  .glyv-flora__clip.is-light {
    display: none;
  }

  .glyv-flora__svg.is-light {
    color: var(--on-dark, var(--cream));
  }

  .glyv-flora__vine {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: 0.82;
  }

  .glyv-flora__vine .is-stem {
    stroke-width: 2.05;
  }

  .glyv-flora__vine .is-shoot {
    stroke-width: 1.45;
  }

  .glyv-flora__vine .is-rib {
    stroke-width: 0.8;
    opacity: 0.7;
  }

  .glyv-flora__vine path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
  }

  .glyv-flora.is-auto .glyv-flora__vine path {
    animation: glyv-flora-vine 3.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .glyv-flora.is-auto .glyv-flora__vine .is-shoot {
    animation-delay: 0.55s;
  }

  .glyv-flora.is-auto .glyv-flora__vine .is-rib {
    animation-delay: 0.95s;
  }

  @keyframes glyv-flora-vine {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyv-flora__vine path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (min-width: 900px) {
    .glyv-flora.is-main,
    .glyv-flora.is-bottom,
    .glyv-flora.is-plate,
