---
import Grainient from '@components/ui/Grainient.astro';
import StepFigure from '@components/home/StepFigure.astro';
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.steps;
const tones = ['is-forest', 'is-petroleum', 'is-forest'] as const;
const figures = ['eliges', 'llega', 'repite'] as const;
---

<section class="home-steps" id={copy.id} aria-labelledby="home-steps-title">
  <div data-slide-host>
    <header class="home-steps__title grain-host" data-slide="left">
      <Grainient tone="cream" />
      <h2 id="home-steps-title">{copy.h2}</h2>
      <p>{copy.lead}</p>
    </header>
  </div>
  {
    copy.items.map((item, i) => (
      <div data-slide-host>
        <article
          class={`home-steps__plate ${tones[i]} grain-host`}
          data-slide={i % 2 === 0 ? 'right' : 'left'}
        >
          <Grainient tone={tones[i] === 'is-petroleum' ? 'petroleum' : 'forest'} />
          <p class="home-steps__n">{item.n}</p>
          <div class="home-steps__copy">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
          <div class="home-steps__figure">
            <StepFigure step={figures[i]} />
          </div>
        </article>
      </div>
    ))
  }
</section>

<style>
  .home-steps {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --petroleum: #3e2770;
    --ink: #1A1228;
  }

  .home-steps__title {
    background: var(--cream);
    color: var(--ink);
    padding: 2.8rem 1.5rem 2rem;
  }

  .home-steps h2 {
    font-family: Fraunces, serif;
    margin: 0;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-steps__title p {
    margin: 0.9rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .home-steps__plate {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.8rem;
    align-items: center;
    padding: 2.2rem 1.5rem;
  }

  .home-steps__n {
    font-family: Fraunces, serif;
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.05em;
  }

  .home-steps__copy {
    grid-column: 1;
    grid-row: 2;
  }

  .home-steps__figure {
    grid-column: 2;
    grid-row: 1 / span 2;
    z-index: 5;
    align-self: center;
    justify-self: end;
  }

  .is-forest {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .is-petroleum {
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
  }

  .home-steps h3 {
    font-family: Fraunces, serif;
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .home-steps h3 + p {
    margin: 0.55rem 0 0;
    max-width: 22rem;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .home-steps__title {
      padding: 3.2rem 2.6rem 2.2rem;
    }

    .home-steps__plate {
      grid-template-columns: 6.5rem minmax(0, 1fr) auto;
      column-gap: 2rem;
      padding: 2.4rem 2.6rem;
    }

    .home-steps__n,
    .home-steps__copy,
    .home-steps__figure {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
