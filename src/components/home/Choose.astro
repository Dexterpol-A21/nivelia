---
import { HOME_PAGE } from '@utils/constants';

const copy = HOME_PAGE.choose;
---

<section class="home-choose" aria-labelledby="home-choose-title">
  <div data-slide-host>
    <header data-slide="left">
      <h2 id="home-choose-title">{copy.h2}</h2>
      <p>{copy.note}</p>
    </header>
  </div>
  <div class="home-choose__row" data-slide-host>
    {
      copy.items.map((item) => (
        <a
          class={`home-choose__plate is-${item.name.toLowerCase()}`}
          href={item.href}
          data-slide={item.name === 'Nervia' ? 'right' : 'left'}
        >
          <h3>{item.name}</h3>
          <p class="home-choose__claim">{item.claim}</p>
          <p>{item.body}</p>
        </a>
      ))
    }
  </div>
</section>

<style>
  .home-choose {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --petroleum: #3e2770;
    --ink: #1A1228;
  }

  .home-choose header {
    position: relative;
    background: var(--cream);
    color: var(--ink);
    padding: 7.6rem 1.5rem 2rem;
  }

  .home-choose header > :not(.ekilia-flora) {
    position: relative;
    z-index: 1;
  }

  .home-choose h2 {
    font-family: Fraunces, serif;
    margin: 0;
    font-size: clamp(2.15rem, 5.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-choose header p {
    margin: 0.9rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .home-choose__row {
    display: grid;
  }

  .home-choose__plate {
    position: relative;
    overflow: hidden;
    display: block;
    padding: 7.6rem 1.5rem 2.6rem;
    color: var(--on-dark, var(--cream));
    text-decoration: none;
  }

  .home-choose__plate > :not(.ekilia-flora):not(.ekilia-nerves) {
    position: relative;
    z-index: 1;
  }

  .home-choose__plate.is-centia {
    background: var(--forest);
  }

  .home-choose__plate.is-nervia {
    background: var(--petroleum);
  }

  .home-choose h3 {
    font-family: Fraunces, serif;
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .home-choose__claim {
    font-family: Fraunces, serif;
    margin: 1rem 0 0;
    max-width: 16ch;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .home-choose__plate p:last-child {
    margin: 0.9rem 0 0;
    max-width: 28rem;
    font-size: 1.02rem;
    line-height: 1.5;
    opacity: 0.86;
  }

  .home-choose__plate:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: -6px;
  }

  @media (min-width: 900px) {
    .home-choose header {
      padding: 8.4rem 2.6rem 2.2rem;
    }

    .home-choose__row {
      grid-template-columns: 1fr 1fr;
    }

    .home-choose__plate {
      min-height: 24rem;
      padding: 8.4rem 2.6rem 2.8rem;
    }
  }
</style>
