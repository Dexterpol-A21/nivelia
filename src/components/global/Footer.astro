---
import { NAV_LINKS, SITE } from '@utils/constants';
---

<footer class="border-t border-border bg-surface pb-24 md:pb-0">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="font-heading text-xl font-bold">{SITE.title}</p>
      <p class="mt-2 max-w-sm text-sm text-text-muted">{SITE.description}</p>
    </div>

    <nav aria-label="Footer">
      <ul class="flex flex-col gap-2">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-muted transition-colors hover:text-text">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
