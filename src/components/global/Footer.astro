---
import { DISCLAIMER, FACEBOOK, FOOTER_LINKS, LEGAL_LINKS, SITE } from '@utils/constants';

interface Props {
  tone?: 'site' | 'centia' | 'nervia';
}

const { tone = 'site' } = Astro.props;
---

<div data-slide-host>
  <footer class:list={['glyv-foot', `is-${tone}`]} data-slide="right">
    <p class="glyv-foot__word">{SITE.title}</p>
    <nav class="glyv-foot__nav" aria-label="Pie">
      <ul>
        {
          FOOTER_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href={FACEBOOK.href} target="_blank" rel="noopener noreferrer">
            {FACEBOOK.label}
          </a>
        </li>
      </ul>
    </nav>
    <p class="glyv-foot__legal">{DISCLAIMER}</p>
    <nav class="glyv-foot__meta" aria-label="Legal">
      <ul>
        {
          LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </footer>
</div>

<style>
  .glyv-foot {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --petroleum: #0b4f6c;
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
    padding: 2.8rem 1.5rem 1.7rem;
    position: relative;
    overflow: hidden;
    font-family: Outfit, sans-serif;
  }

  .glyv-foot.is-centia {
    background: var(--forest);
  }

  .glyv-foot__word {
    margin: 0;
    font-family: Fraunces, serif;
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .glyv-foot ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .glyv-foot a {
    color: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .glyv-foot a:hover,
  .glyv-foot a:focus-visible {
    opacity: 0.72;
  }

  .glyv-foot a:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 4px;
  }

  .glyv-foot__nav ul {
    display: flex;
    flex-flow: row wrap;
    gap: 0.55rem 1.15rem;
    margin-top: 1rem;
  }

  .glyv-foot__legal {
    margin: 1.25rem 0 0;
    max-width: 40rem;
    font-size: 0.82rem;
    line-height: 1.5;
    opacity: 0.78;
  }

  .glyv-foot__meta ul {
    display: flex;
    flex-flow: row wrap;
    gap: 0.45rem 1.15rem;
    margin-top: 0.9rem;
  }

  .glyv-foot__meta a {
    font-size: 0.82rem;
    font-weight: 600;
    opacity: 0.78;
  }

  @media (min-width: 900px) {
    .glyv-foot {
      padding: 3.2rem 2.6rem 1.9rem;
    }

    .glyv-foot__nav ul {
      margin-top: 1.15rem;
      gap: 0.45rem 1.4rem;
    }

    .glyv-foot__legal {
      margin-top: 1.4rem;
    }

    .glyv-foot__meta ul {
      margin-top: 1rem;
      gap: 0.35rem 1.4rem;
    }
  }
</style>
