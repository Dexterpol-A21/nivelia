---
import Grainient from '@components/ui/Grainient.astro';
import { CONTACT, DISCLAIMER, FACEBOOK, FOOTER_LINKS, LEGAL_LINKS, SITE } from '@utils/constants';

interface Props {
  tone?: 'site' | 'centia' | 'nervia';
}

const { tone = 'site' } = Astro.props;
---

<div data-slide-host>
  <footer class:list={['ekilia-foot', `is-${tone}`, 'grain-host']} data-slide="right">
    <Grainient tone={tone === 'centia' ? 'forest' : 'petroleum'} />
    <p class="ekilia-foot__word">{SITE.title}</p>
    <p class="ekilia-foot__mail">
      <a href={CONTACT.href}>{CONTACT.email}</a>
    </p>
    <nav class="ekilia-foot__nav" aria-label="Pie">
      <ul>
        {
          FOOTER_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href={FACEBOOK.href} target="_blank" rel="noopener noreferrer">
            {FACEBOOK.label}
          </a>
        </li>
      </ul>
    </nav>
    <p class="ekilia-foot__legal">{DISCLAIMER}</p>
    <nav class="ekilia-foot__meta" aria-label="Legal">
      <ul>
        {
          LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </footer>
</div>

<style>
  .ekilia-foot {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --petroleum: #3e2770;
    background: var(--petroleum);
    color: var(--on-dark, var(--cream));
    padding: 2.8rem 1.5rem 1.7rem;
    position: relative;
    overflow: hidden;
  }

  .ekilia-foot.is-centia {
    background: var(--forest);
  }

  .ekilia-foot__word {
    font-family: Fraunces, serif;
    font-optical-sizing: none;
    font-variation-settings: "opsz" 144, "wght" 600;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .ekilia-foot ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ekilia-foot a {
    color: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .ekilia-foot a:hover,
  .ekilia-foot a:focus-visible {
    opacity: 0.72;
  }

  .ekilia-foot a:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 4px;
  }

  .ekilia-foot__mail {
    margin: 0.85rem 0 0;
  }

  .ekilia-foot__mail a {
    font-size: 1.02rem;
    overflow-wrap: anywhere;
  }

  .ekilia-foot__nav ul {
    display: flex;
    flex-flow: row wrap;
    gap: 0.55rem 1.15rem;
    margin-top: 1rem;
  }

  .ekilia-foot__legal {
    margin: 1.25rem 0 0;
    max-width: 40rem;
    font-size: 0.82rem;
    line-height: 1.5;
    opacity: 0.78;
  }

  .ekilia-foot__meta ul {
    display: flex;
    flex-flow: row wrap;
    gap: 0.45rem 1.15rem;
    margin-top: 0.9rem;
  }

  .ekilia-foot__meta a {
    font-size: 0.82rem;
    font-weight: 600;
    opacity: 0.78;
  }

  @media (min-width: 900px) {
    .ekilia-foot {
      padding: 3.2rem 2.6rem 1.9rem;
    }

    .ekilia-foot__nav ul {
      margin-top: 1.15rem;
      gap: 0.45rem 1.4rem;
    }

    .ekilia-foot__legal {
      margin-top: 1.4rem;
    }

    .ekilia-foot__meta ul {
      margin-top: 1rem;
      gap: 0.35rem 1.4rem;
    }
  }
</style>
