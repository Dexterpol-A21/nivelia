---
import { SOCIAL_LINKS } from '@utils/constants';
---

<nav class="social-dock" aria-label="Redes">
  {
    SOCIAL_LINKS.map((link) => (
      <a
        class={`social-dock__btn is-${link.id}`}
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
      >
        {link.id === 'ig' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
            <circle cx="12" cy="12" r="4.15" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
            <circle cx="17.35" cy="6.65" r="1.15" fill="currentColor"></circle>
          </svg>
        )}
        {link.id === 'x' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M13.5 10.47 21.2 2h-2.55l-5.73 7.32L8.3 2H2.7l7.7 10.55L2 22h2.55l6.22-8 5.54 8H22L13.5 10.47Zm-1.1 2.74-.93-1.16L5.2 3.7h2.5l4.73 7.15.93 1.16 6.18 8.45h-2.5l-5.14-7.25Z"
            ></path>
          </svg>
        )}
        {link.id === 'in' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M4.7 9.2h3.2V20H4.7V9.2ZM6.3 3.6c1.2 0 2.1.9 2.1 2.1S7.5 7.8 6.3 7.8 4.2 6.9 4.2 5.7s.9-2.1 2.1-2.1ZM10.4 9.2h3.1v1.5h.1c.4-.8 1.5-1.7 3.1-1.7 3.3 0 3.9 2.2 3.9 5.1V20H14.3v-5.4c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V20H10.4V9.2Z"
            ></path>
          </svg>
        )}
        {link.id === 'yt' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M22.5 7.6c-.3-1.1-1.1-2-2.2-2.2C18.4 5 12 5 12 5s-6.4 0-8.3.4c-1.1.2-1.9 1.1-2.2 2.2C1.1 9.5 1.1 12 1.1 12s0 2.5.4 4.4c.3 1.1 1.1 2 2.2 2.2C5.6 19 12 19 12 19s6.4 0 8.3-.4c1.1-.2 1.9-1.1 2.2-2.2.4-1.9.4-4.4.4-4.4s0-2.5-.4-4.4ZM10.2 15.2V8.8L15.6 12l-5.4 3.2Z"
            ></path>
          </svg>
        )}
      </a>
    ))
  }
</nav>

<style>
  .social-dock {
    position: fixed;
    left: 1rem;
    bottom: 1.15rem;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .social-dock__btn {
    display: grid;
    width: 3.15rem;
    height: 3.15rem;
    place-items: center;
    border-radius: 0;
    background: #f4efe6;
    color: #1e4a32;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-dock__btn svg {
    width: 1.42rem;
    height: 1.42rem;
    display: block;
  }

  .social-dock__btn:focus-visible {
    outline: 2px solid #f4efe6;
    outline-offset: 3px;
  }

  .social-dock__btn:hover,
  .social-dock__btn:focus-visible {
    color: #fff;
    transform: scale(1.06);
  }

  .social-dock__btn.is-ig:hover,
  .social-dock__btn.is-ig:focus-visible {
    background: linear-gradient(135deg, #f9ce34 0%, #ee2a7b 50%, #6228d7 100%);
  }

  .social-dock__btn.is-x:hover,
  .social-dock__btn.is-x:focus-visible {
    background: #000;
  }

  .social-dock__btn.is-in:hover,
  .social-dock__btn.is-in:focus-visible {
    background: #0a66c2;
  }

  .social-dock__btn.is-yt:hover,
  .social-dock__btn.is-yt:focus-visible {
    background: #ff0000;
  }

  @media (max-width: 699px) {
    .social-dock {
      left: 0.75rem;
      bottom: 0.85rem;
    }

    .social-dock__btn {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-dock__btn {
      transition: none;
    }

    .social-dock__btn:hover,
    .social-dock__btn:focus-visible {
      transform: none;
    }
  }
</style>
