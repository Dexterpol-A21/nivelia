---
interface Section {
  title: string;
  paragraphs: readonly string[];
}

interface Props {
  title: string;
  lead: string;
  updated: string;
  sections: readonly Section[];
  relatedHref: string;
  relatedLabel: string;
}

const { title, lead, updated, sections, relatedHref, relatedLabel } = Astro.props;
---

<article class="legal">
  <header class="legal__intro">
    <h1>{title}</h1>
    <p>{lead}</p>
    <p class="legal__updated">{updated}</p>
  </header>

  <div class="legal__body">
    {
      sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }
    <p class="legal__next">
      <a href={relatedHref}>{relatedLabel}</a>
    </p>
  </div>
</article>

<style>
  .legal {
    --cream: #f4efe6;
    --forest: #1e4a32;
    --ink: #1a2a22;
    --hover: 0.48s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: Outfit, sans-serif;
  }

  .legal__intro,
  .legal__body {
    padding: 6.5rem 1.5rem 3.2rem;
  }

  .legal__intro {
    background: var(--cream);
    color: var(--ink);
    padding-bottom: 2.6rem;
  }

  .legal h1 {
    margin: 0;
    max-width: 12ch;
    font-family: Fraunces, serif;
    font-size: clamp(2.8rem, 8vw, 5.2rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .legal__intro p {
    margin: 1.15rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .legal__updated {
    font-size: 0.92rem;
    opacity: 0.72;
  }

  .legal__body {
    background: var(--forest);
    color: var(--on-dark, var(--cream));
    padding-top: 2.4rem;
  }

  .legal__body section {
    max-width: 40rem;
    padding: 1.35rem 0 1.15rem;
    border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .legal__body h2 {
    margin: 0;
    font-family: Fraunces, serif;
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .legal__body section p {
    margin: 0.85rem 0 0;
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .legal__next {
    max-width: 40rem;
    margin: 0;
    padding: 1.5rem 0 0.4rem;
    border-top: 1.5px solid color-mix(in srgb, var(--cream) 28%, transparent);
  }

  .legal__next a {
    position: relative;
    display: inline-block;
    padding-bottom: 0.2rem;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .legal__next a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--hover);
  }

  .legal__next a:hover::after,
  .legal__next a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .legal__next a:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 4px;
  }

  @media (min-width: 900px) {
    .legal__intro,
    .legal__body {
      padding-left: 2.6rem;
      padding-right: 2.6rem;
    }

    .legal__intro {
      padding-top: 8rem;
      padding-bottom: 3.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal__next a::after {
      transition: none;
    }
  }
</style>
