---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="ekilia-store" aria-label="Tienda">
  <a href="/cuenta" aria-current={pathname === '/cuenta' ? 'page' : undefined}>
    <span class="ekilia-store__bloom" aria-hidden="true">
      <span class="ekilia-store__layers">
        <span class="ekilia-store__layer is-1"></span>
        <span class="ekilia-store__layer is-2"></span>
        <span class="ekilia-store__layer is-3"></span>
      </span>
    </span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="8" r="3.1" />
      <path d="M5.2 19.2v-.6c0-2.7 2.5-4.5 6.8-4.5s6.8 1.8 6.8 4.5v.6" />
    </svg>
    <span class="ekilia-store__label">Cuenta</span>
  </a>
  <a class="is-buy" href="/carrito" aria-current={pathname === '/carrito' ? 'page' : undefined}>
    <span class="ekilia-store__bloom" aria-hidden="true">
      <span class="ekilia-store__layers">
        <span class="ekilia-store__layer is-1"></span>
        <span class="ekilia-store__layer is-2"></span>
        <span class="ekilia-store__layer is-3"></span>
      </span>
    </span>
    <span class="ekilia-store__label">Comprar ahora</span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8.2 8.2V5.6h7.6v2.6" />
      <path d="M4.6 8.2h14.8l-1.35 11.2H5.95z" />
    </svg>
  </a>
</nav>

<style>
  .ekilia-store {
    font-family: Outfit, sans-serif;
    --cream: #f6f3ee;
    --forest: #0e6e9e;
    --petroleum: #3e2770;
    --turquoise: #0f6468;
    --bloom: var(--forest);
    --bloom-fill: var(--cream);
    --bloom-ink: var(--forest);
    position: fixed;
    top: var(--nav-chip-top, max(1.15rem, env(safe-area-inset-top, 0px)));
    right: calc(0.7rem + max(1.15rem, env(safe-area-inset-right, 0px)));
    z-index: 90;
    display: flex;
    height: var(--nav-chip-h, 2.75rem);
    background: var(--forest);
    color: var(--on-dark, var(--cream));
  }

  .ekilia-store a {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    width: 2.75rem;
    border: 0;
    border-right: 1.5px solid color-mix(in srgb, currentColor 28%, transparent);
    color: inherit;
    text-decoration: none;
  }

  .ekilia-store__bloom {
    pointer-events: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .ekilia-store__layers {
    position: absolute;
    left: 50%;
    top: -60%;
    width: max(220%, 10rem);
    aspect-ratio: 1;
    transform: translate(-50%);
  }

  .ekilia-store__layer {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform: scale(0);
    transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .ekilia-store__layer.is-1 {
    background: var(--bloom);
  }

  .ekilia-store__layer.is-2,
  .ekilia-store__layer.is-3 {
    background: var(--bloom-fill);
  }

  .ekilia-store a:hover .ekilia-store__layer.is-1,
  .ekilia-store a:focus-visible .ekilia-store__layer.is-1 {
    transform: scale(1);
  }

  .ekilia-store a:hover .ekilia-store__layer.is-2,
  .ekilia-store a:focus-visible .ekilia-store__layer.is-2 {
    transform: scale(1);
    transition-delay: 0.12s;
  }

  .ekilia-store a:hover .ekilia-store__layer.is-3,
  .ekilia-store a:focus-visible .ekilia-store__layer.is-3 {
    transform: scale(1);
    transition-delay: 0.24s;
  }

  .ekilia-store a.is-buy {
    display: flex;
    width: auto;
    gap: 0.4rem;
    padding: 0 0.85rem 0 0.95rem;
  }

  .ekilia-store a:last-child {
    border-right: 0;
  }

  .ekilia-store a[aria-current='page']::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 3px;
    background: var(--cream);
  }

  .ekilia-store svg {
    position: relative;
    z-index: 1;
    width: 1.28rem;
    height: 1.28rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: square;
    stroke-linejoin: miter;
    transition: color 0.35s linear 0.12s;
  }

  .ekilia-store a:hover svg,
  .ekilia-store a:focus-visible svg,
  .ekilia-store a.is-buy:hover .ekilia-store__label,
  .ekilia-store a.is-buy:focus-visible .ekilia-store__label {
    color: var(--bloom-ink);
  }

  .ekilia-store__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ekilia-store a.is-buy .ekilia-store__label {
    position: relative;
    z-index: 1;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    transition: color 0.35s linear 0.12s;
  }

  .ekilia-store a:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 3px;
  }

  :global(.ekilia-nav.is-open) ~ .ekilia-store {
    --bloom: var(--cream);
    --bloom-fill: var(--cream);
    --bloom-ink: var(--forest);
    background: var(--cream);
    color: var(--forest);
  }

  :global(.ekilia-nav.is-open) ~ .ekilia-store a:focus-visible {
    outline-color: var(--forest);
  }

  :global(.ekilia-nav.is-open) ~ .ekilia-store a[aria-current='page']::after {
    background: var(--forest);
  }

  @media (max-width: 899px) {
    .ekilia-store {
      top: auto;
      right: 0;
      bottom: 0;
      left: calc(100% / 3.45);
      box-sizing: border-box;
      display: grid;
      grid-template-columns: 1fr 1.45fr;
      width: auto;
      height: var(--nav-dock);
      padding-right: env(safe-area-inset-right, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: transparent;
    }

    .ekilia-store a,
    .ekilia-store a.is-buy {
      display: flex;
      width: auto;
      height: var(--nav-bar);
      justify-content: center;
      gap: 0.4rem;
      padding: 0 0.55rem;
    }

    .ekilia-store__label,
    .ekilia-store a.is-buy .ekilia-store__label {
      position: relative;
      z-index: 1;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      font-size: 0.85rem;
      font-weight: 600;
      line-height: 1;
      letter-spacing: 0.01em;
    }

    .ekilia-store svg {
      width: 1.05rem;
      height: 1.05rem;
    }

    :global(.ekilia-nav.is-open) ~ .ekilia-store {
      --bloom: var(--forest);
      --bloom-fill: var(--cream);
      --bloom-ink: var(--forest);
      background: transparent;
      color: var(--cream);
    }

    :global(.ekilia-nav.is-open) ~ .ekilia-store a:focus-visible {
      outline-color: var(--cream);
    }

    :global(.ekilia-nav.is-open) ~ .ekilia-store a[aria-current='page']::after {
      background: var(--cream);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ekilia-store__layer {
      display: none;
    }

    .ekilia-store svg {
      transition: none;
    }

    .ekilia-store a:hover,
    .ekilia-store a:focus-visible {
      background: var(--bloom-fill);
    }

    .ekilia-store a:hover svg,
    .ekilia-store a:focus-visible svg {
      color: var(--bloom-ink);
    }
  }
</style>
